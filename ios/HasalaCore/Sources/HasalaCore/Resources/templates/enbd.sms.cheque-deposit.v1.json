{
  "id": "enbd.sms.cheque-deposit.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "the cheque number ",
      " has been deposited to account "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "(?:^|, )the cheque number [0-9]{1,16} for (?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) has been deposited to account "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        " has been deposited to account [0-9X-]{4,24} on (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4}) "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD CHEQUE DEPOSIT"
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
