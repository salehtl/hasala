{
  "id": "enbd.alert.v1",
  "version": 3,
  "bank": "enbd",
  "normalizer_version": 1,
  "match": {
    "sender_domain": [
      "emiratesnbd.com"
    ]
  },
  "default_currency": "AED",
  "date_from": "email",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "flags": [
        "i"
      ],
      "patterns": [
        "(?P<ccy>[A-Z]{3})(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\t\\n\\f\\r]has been[ \\t\\n\\f\\r](?:withdrawn|debited|deducted)[ \\t\\n\\f\\r]from your account",
        "(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\t\\n\\f\\r]has been[ \\t\\n\\f\\r](?:withdrawn|debited|deducted)[ \\t\\n\\f\\r]from your account"
      ],
      "on_match": {
        "direction": "debit"
      }
    },
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "flags": [
        "i"
      ],
      "patterns": [
        "(?P<ccy>[A-Z]{3})(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\t\\n\\f\\r]has been[ \\t\\n\\f\\r](?:credited|deposited)[ \\t\\n\\f\\r](?:in)?to your account",
        "(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\t\\n\\f\\r]has been[ \\t\\n\\f\\r](?:credited|deposited)[ \\t\\n\\f\\r](?:in)?to your account"
      ],
      "on_match": {
        "direction": "credit"
      }
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "subject",
      "flags": [
        "i"
      ],
      "patterns": [
        "account ending with[ \\t\\n\\f\\r]+(?P<v>[0-9]{4})"
      ]
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
