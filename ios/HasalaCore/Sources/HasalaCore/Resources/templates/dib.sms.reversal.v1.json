{
  "id": "dib.sms.reversal.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "A transaction to the value of",
      "has been reversed."
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^A transaction to the value of (?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        " made at (?P<v>[^\\n]+) on your DIB card ending with "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB CARD REVERSAL"
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        "on your DIB card ending with (?P<v>[^ \\n]+) has been reversed"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
