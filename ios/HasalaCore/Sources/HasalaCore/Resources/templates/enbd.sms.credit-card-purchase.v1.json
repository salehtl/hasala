{
  "id": "enbd.sms.credit-card-purchase.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "You made a purchase of ",
      " with your Credit Card ending "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^You made a purchase of (?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) at "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        "^You made a purchase of [A-Z]{3} [0-9][0-9,.]{0,27} at (?P<v>[^,\\n]+) with your Credit Card ending ",
        "^You made a purchase of [A-Z]{3} [0-9][0-9,.]{0,27} at (?P<v>[^,\\n]+), "
      ]
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        " with your Credit Card ending (?P<v>[0-9]{4})"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
