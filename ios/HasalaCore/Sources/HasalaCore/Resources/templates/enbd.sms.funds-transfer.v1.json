{
  "id": "enbd.sms.funds-transfer.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "Funds Transfer of ",
      " has been made using your Debit Card ending "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^Funds Transfer of (?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) has been made using your Debit Card ending "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        " using your Debit Card ending [0-9]{4} at (?P<v>[^\\n]+?)\\. Your current balance is "
      ]
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        " using your Debit Card ending (?P<v>[0-9]{4}) at "
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
