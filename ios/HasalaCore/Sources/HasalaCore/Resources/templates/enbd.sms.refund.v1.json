{
  "id": "enbd.sms.refund.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "Purchase amount of ",
      " has been refunded to your card account"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^Purchase amount of (?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) at "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        "^Purchase amount of [A-Z]{3} [0-9][0-9,.]{0,27} at (?P<v>[^\\n]+?) on your Debit Card ending "
      ]
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        " on your Debit Card ending (?P<v>[0-9]{4}) has been refunded"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
