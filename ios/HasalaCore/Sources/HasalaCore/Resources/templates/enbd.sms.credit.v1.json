{
  "id": "enbd.sms.credit.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "has been credited to "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "(?:^|, )(?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) has been credited to (?:your )?account "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD INSTANT TRANSFER",
      "patterns": [
        " towards instant transfer\\."
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD INWARD TRANSFER",
      "patterns": [
        " IPI TT REF",
        " DTB TR REF "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD GLOBAL EQUITIES",
      "patterns": [
        " MOBILE WTH GL EQ "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD MOBILE TRANSFER",
      "patterns": [
        " MOBILE TRF"
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        " to your account no\\. [0-9X-]{4,24} (?P<v>[^\\n]+?)\\. The available balance is "
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true",
      "patterns": [
        " MOBILE WTH GL EQ ",
        " MOBILE TRF"
      ]
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
