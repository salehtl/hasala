{
  "id": "adib.account.v1",
  "version": 1,
  "bank": "adib",
  "normalizer_version": 1,
  "match": {
    "sender_domain": [
      "adib.ae"
    ],
    "body_contains": [
      "Your available account balance"
    ]
  },
  "default_currency": "AED",
  "date_from": "email",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "flags": [
        "i"
      ],
      "patterns": [
        "(?P<ccy>[A-Z]{3})(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\n]was debited from your account",
        "(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\n]was debited from your account"
      ],
      "on_match": {
        "direction": "debit"
      }
    },
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "flags": [
        "i"
      ],
      "patterns": [
        "(?P<ccy>[A-Z]{3})(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\n]was credited to your account",
        "(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})[ \\n]was credited to your account"
      ],
      "on_match": {
        "direction": "credit"
      }
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "flags": [
        "i"
      ],
      "patterns": [
        "was (?:debited from|credited to) your account[ \\n][*]?(?P<v>[0-9]{1,8})"
      ]
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
