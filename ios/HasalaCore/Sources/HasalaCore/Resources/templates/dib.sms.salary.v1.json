{
  "id": "dib.sms.salary.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "راتب"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^(?:إيداع|ايداع) راتب [0-9]{2}-[0-9]{2}-[0-9]{4} - مبلغ (?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) ",
        "^تم (?:ايداع|إيداع) راتب شهر [0-9]{2}-[0-9]{2}-[0-9]{4}- بمبلغ (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) درهم"
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        "راتب (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4}) - مبلغ ",
        "راتب شهر (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4})- بمبلغ "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "SALARY"
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
