<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The exported (distribution-signed) app's entitlements, spec 06 §10.3 I1: the
  Release entitlements (§3.2) after $(AppIdentifierPrefix) expansion, with what
  the distribution re-sign sets. archive.sh compares the .ipa's entitlements with
  this file exactly, ignoring only beta-reports-active (added by Apple) and the
  order of array entries.
-->
<plist version="1.0">
<dict>
  <key>application-identifier</key>
  <string>8CFG28JHP3.app.hasala.ios</string>
  <key>aps-environment</key>
  <string>production</string>
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>webcredentials:hasala.app</string>
    <string>applinks:hasala.app</string>
  </array>
  <key>com.apple.developer.team-identifier</key>
  <string>8CFG28JHP3</string>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.app.hasala.ios</string>
  </array>
  <key>get-task-allow</key>
  <false/>
  <key>keychain-access-groups</key>
  <array>
    <string>8CFG28JHP3.app.hasala.ios</string>
    <string>8CFG28JHP3.app.hasala.shared</string>
  </array>
</dict>
</plist>
