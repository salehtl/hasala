  <string>8CFG28JHP3.app.hasala.ios.widgets</string>
  <key>com.apple.developer.team-identifier</key>
  <string>8CFG28JHP3</string>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.app.hasala.ios</string>
  </array>
  <key>get-task-allow</key>
  <false/>
</dict>
</plist>
