{
  "name": "hasala-assist",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "assist.hasala.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "logpush": false,
  "send_metrics": false,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "GLOBAL", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": { "REFUSED_CLIENTS": "" }
}
