{
  "id": "dib.money-transfer.v1",
  "version": 1,
  "bank": "dib",
  "normalizer_version": 1,
  "match": {
    "sender_domain": [
      "dib.ae"
    ],
    "body_contains": [
      "Money Transfer\n",
      "Status\nCredited to beneficiary"
    ]
  },
  "default_currency": "AED",
  "date_from": "email",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "\\nAmount\\n(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})(?:[^0-9]|$)"
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        "\\nBeneficiary Bank\\n(?P<v>[^\\n]+)"
      ]
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        "\\nFrom\\n(?P<v>[^ \\n]+)"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
