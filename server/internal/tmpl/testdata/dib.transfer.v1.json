{
  "id": "dib.transfer.v1",
  "version": 1,
  "bank": "dib",
  "normalizer_version": 1,
  "match": {
    "sender_domain": [
      "dib.ae"
    ],
    "body_contains": [
      "إشعار تحويل الأموال",
      "الحالة\nتمت بنجاح"
    ]
  },
  "default_currency": "AED",
  "date_from": "body",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "المبلغ\\n(?:\\(يشمل [0-9]{1,2}% ضريبة القيمة المضافة\\)\\n)?(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})(?:[^0-9]|$)"
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        "بتاريخ (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4})"
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        "البنك المستفيد\\n(?P<v>[^\\n]+)"
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB OWN ACCOUNTS TRANSFER",
      "patterns": [
        "بين حساباتك"
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB TRANSFER"
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        "من حساب\\n(?P<v>[^ \\n]+)"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true"
    }
  ],
  "required": [
    "amount",
    "direction",
    "date"
  ]
}
