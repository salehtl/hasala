{
  "id": "enbd.sms.transfer-in.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "has been transferred to your account "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "(?:^|, )(?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) has been transferred to your account "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD TRANSFER"
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
