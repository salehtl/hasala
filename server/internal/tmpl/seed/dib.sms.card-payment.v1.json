{
  "id": "dib.sms.card-payment.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "تم سداد مبلغ"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^تم سداد مبلغ (?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) لبطاقتك "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY HH:mm"
      ],
      "patterns": [
        " في \\.?(?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4} [0-9]{2}:[0-9]{2}) "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB CARD PAYMENT"
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        "لبطاقتك المنتهية بـ{0,8} (?P<v>[^ \\n]+) في "
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
