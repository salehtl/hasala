{
  "id": "dib.sms.refund.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "تم إرجاع مبلغ"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^تم إرجاع مبلغ (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) درهم "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB CARD REFUND"
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        "والمنتهية بالرقم (?P<v>[^ \\n.]+)"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
