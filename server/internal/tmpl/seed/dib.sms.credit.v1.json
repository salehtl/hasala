{
  "id": "dib.sms.credit.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "يداع"
    ],
    "body_not_contains": [
      "راتب",
      "بين حساباتك"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^ايداع (?:بمبلغ )?(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) في ",
        "^إيداع (?:بمبلغ )?(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) في "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        " في (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4}) "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        " في [0-9]{2}-[0-9]{2}-[0-9]{4} (?P<v>[^\\n]+) رصيدك"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true",
      "flags": [
        "i"
      ],
      "patterns": [
        " في [0-9]{2}-[0-9]{2}-[0-9]{4} [^\\n]*(?:TRNSFER|TRANSFER)"
      ]
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
