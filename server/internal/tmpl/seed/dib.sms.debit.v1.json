{
  "id": "dib.sms.debit.v1",
  "version": 1,
  "bank": "dib",
  "channel": "sms",
  "transfer_role": "alert",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "DIB-SMS"
    ],
    "body_contains": [
      "خصم"
    ],
    "body_not_contains": [
      "بين حساباتك",
      "للخصم"
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^خصم (?:بمبلغ )?(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) في ",
        "^تم خصم (?:مبلغ )?(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) ",
        "^خصم صراف آلي دولي بمبلغ (?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) في "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY HH:mm"
      ],
      "patterns": [
        " في (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4} [0-9]{1,2}:[0-9]{2}) "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        " في (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4}) "
      ]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": [
        "DD-MM-YYYY"
      ],
      "patterns": [
        " بتاريخ (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4}) "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB CARD PAYMENT",
      "patterns": [
        "دفعة لبطاقة دبي الإسلامي الائتمانية",
        "كدفعة للبطاقة"
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "DIB INTERNATIONAL ATM WITHDRAWAL",
      "patterns": [
        "^خصم صراف آلي دولي بمبلغ "
      ]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": [
        " في [0-9]{2}-[0-9]{2}-[0-9]{4} (?P<v>[^\\n]+) رصيدك",
        " بتاريخ [0-9]{2}-[0-9]{2}(?:-[0-9]{4})? (?P<v>[^\\n]+)$"
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true",
      "patterns": [
        "دفعة لبطاقة دبي الإسلامي الائتمانية",
        "كدفعة للبطاقة"
      ]
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true",
      "flags": [
        "i"
      ],
      "patterns": [
        " في [0-9]{2}-[0-9]{2}-[0-9]{4} [^\\n]*(?:TRNSFER|TRANSFER)",
        " بتاريخ [^\\n]*(?:TRNSFER|TRANSFER)"
      ]
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
