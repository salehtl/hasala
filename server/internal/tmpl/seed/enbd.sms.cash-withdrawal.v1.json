{
  "id": "enbd.sms.cash-withdrawal.v1",
  "version": 1,
  "bank": "enbd",
  "channel": "sms",
  "normalizer_version": 1,
  "match": {
    "sms_sender": [
      "EmiratesNBD",
      "ENBD"
    ],
    "body_contains": [
      "Cash Withdrawal of ",
      " with Debit Card ending "
    ]
  },
  "default_currency": "AED",
  "date_from": "received",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": [
        "^Cash Withdrawal of (?P<ccy>[A-Z]{3}) (?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2}) with Debit Card ending "
      ]
    },
    {
      "field": "merchant",
      "type": "const",
      "source": "body",
      "value": "ENBD CASH WITHDRAWAL"
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": [
        " with Debit Card ending (?P<v>[0-9]{4}) at "
      ]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit"
    }
  ],
  "required": [
    "amount",
    "direction"
  ]
}
