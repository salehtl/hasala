# Workers Static Assets: response headers by path. The page's script and
# style hashes live in each page's CSP <meta> (Astro generates them); this
# header adds what a <meta> policy cannot carry (frame-ancestors) and pins
# the rest. Both policies are enforced together.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin

# Pages whose address carries a code or a token (in the path for /i/<code>,
# in the fragment for the rest): no referrer, ever, and never cached. Each
# page also carries <meta name="referrer" content="no-referrer">. The "!"
# lines drop the site-wide value first, so only one of each header is sent.
#
# No Cloudflare Web Analytics here either. Cloudflare's edge injects its
# beacon into every HTML page, and Web Analytics records page paths, so on
# these pages it would record invite codes. Their Content-Security-Policy is
# the site-wide one plus script-src and connect-src without
# static.cloudflareinsights.com and cloudflareinsights.com, so the beacon
# can neither load nor report. The browser enforces it together with the
# page's CSP <meta> (which does admit Web Analytics), so it only narrows
# what the page allows. The build writes those two directives in place of
# the CSP_WITHOUT_ANALYTICS placeholder (src/lib/csp-union.mjs): the
# <meta>'s script-src and connect-src, same hashes and 'self', minus Web
# Analytics. scripts/check-dist.ts checks the result for every page that
# sends no referrer. src/scripts/router.ts always loads these pages in
# full, as a header applies only to a document the browser loads itself.
/i
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests; %CSP_WITHOUT_ANALYTICS%
  Cache-Control: no-store
/i/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests; %CSP_WITHOUT_ANALYTICS%
  Cache-Control: no-store
/freeze
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests; %CSP_WITHOUT_ANALYTICS%
  Cache-Control: no-store
/waitlist/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests; %CSP_WITHOUT_ANALYTICS%
  Cache-Control: no-store

# Fingerprinted build output: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names: revalidate daily.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-*
  Cache-Control: public, max-age=86400
/brand/*
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400

# Apple fetches this through its CDN; it must be JSON, served without a redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
