# Copy to .env to override. All values are public and baked into the build.
# The API base the forms post to, including /api: the waitlist posts to
# PUBLIC_API_BASE + /v1/waitlist. Default: https://api.hasala.app/api
PUBLIC_API_BASE=https://api.hasala.app/api
# Cloudflare Turnstile site key. Leave empty to build without Turnstile.
PUBLIC_TURNSTILE_SITEKEY=
