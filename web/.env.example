# Copy to .env to override. All values are public and baked into the build.
# How the invite form sends: "api" (default; posts to PUBLIC_API_BASE, and
# the request shows up in the operator console's waitlist) or "email" (opens
# a pre-filled email to support@hasala.app, posts nothing, no Turnstile).
PUBLIC_WAITLIST_MODE=api
# The API base the forms post to, including /api: the waitlist posts to
# PUBLIC_API_BASE + /v1/waitlist. Default: https://api.hasala.app/api
PUBLIC_API_BASE=https://api.hasala.app/api
# Cloudflare Turnstile site key ("api" mode only). Leave empty to build
# without Turnstile.
PUBLIC_TURNSTILE_SITEKEY=
