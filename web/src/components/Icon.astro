---
/**
 * The small line icons from the Paper boards, drawn with currentColor so
 * the surrounding text colour styles them. Decorative unless `label` is set.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  label?: string;
  class?: string;
  stroke?: number;
}

const ICONS = {
  'arrow-right': { vb: 16, d: ['M3 8h9.5M8.5 3.5 13 8l-4.5 4.5'], cap: true },
  'arrow-left': { vb: 16, d: ['M13 8H3.5M7.5 3.5 3 8l4.5 4.5'], cap: true },
  'arrow-down': { vb: 16, d: ['M8 3v9.5M3.5 8.5 8 13l4.5-4.5'], cap: true },
  'arrow-up': { vb: 16, d: ['M8 13V3.5M3.5 7.5 8 3l4.5 4.5'], cap: true },
  'arrow-top': { vb: 12, d: ['M6 10V2.5M2.5 5.5 6 2l3.5 3.5'], cap: true },
  undo: { vb: 16, d: ['M5.5 3.5 2.5 6.5l3 3M2.8 6.5h7a3.7 3.7 0 0 1 0 7.4H7'], cap: true },
  lock: { vb: 18, d: ['M5.8 8V5.8a3.2 3.2 0 0 1 6.4 0V8'], rect: [3.5, 8, 11, 8, 2.2], cap: true },
  mail: { vb: 18, d: ['m2.8 5 6.2 4.6L15.2 5'], rect: [2, 3.5, 14, 11, 2.5] },
  people: {
    vb: 18,
    d: ['M1.8 15.5c.6-2.9 2.6-4.5 5.2-4.5 1.2 0 2.2.3 3 .9', 'M13.5 12.5v3.5M13.5 14.5h1.6'],
    circles: [
      [7, 6, 3.2],
      [13.5, 10.5, 2],
    ],
    cap: true,
  },
  'shield-check': { vb: 18, d: ['M9 1.8 15 4v4.6c0 3.7-2.5 6.4-6 7.6-3.5-1.2-6-3.9-6-7.6V4l6-2.2Z', 'm6.4 8.9 1.8 1.8 3.5-3.6'], cap: true },
  shield: { vb: 24, d: ['M12 3.5 5 6.2v5.3c0 4.3 2.9 7.6 7 9 4.1-1.4 7-4.7 7-9V6.2l-7-2.7Z'] },
  check: { vb: 16, d: ['m3.5 8.3 2.8 2.8 6.2-6.3'], cap: true },
  chevron: { vb: 12, d: ['m2.5 4.5 3.5 3.5 3.5-3.5'], cap: true },
  'chevron-right': { vb: 12, d: ['m4.5 2.5 3.5 3.5-3.5 3.5'], cap: true },
  plus: { vb: 14, d: ['M2.5 7h9M7 2.5v9'], cap: true },
  minus: { vb: 14, d: ['M2.5 7h9'], cap: true },
  link: { vb: 16, d: ['M6.5 9.5 9.5 6.5M7 4.5l1.2-1.2a2.8 2.8 0 0 1 4 4L11 8.5M9 11.5l-1.2 1.2a2.8 2.8 0 0 1-4-4L5 7.5'], cap: true },
  clock: { vb: 16, d: ['M8 4.8V8l2.2 1.4'], circles: [[8, 8, 6.2]], cap: true },
  info: { vb: 20, d: ['M10 9v5'], circles: [[10, 10, 8]], dots: [[10, 6.2, 1.1]], cap: true },
  alert: { vb: 16, d: ['M8 4.6v4.2'], circles: [[8, 8, 6.6]], dots: [[8, 11.2, 0.95]], cap: true },
  key: { vb: 22, d: ['M11.5 11H19M16.5 11v3M19 11v2.5'], circles: [[7.5, 11, 4]], cap: true },
  phone: { vb: 22, d: ['M9.5 16.5h3'], rect: [6, 2.5, 10, 17, 2.5], cap: true },
  menu: { vb: 24, d: ['M5 9h14M5 15h14'], cap: true },
  close: { vb: 24, d: ['M6.5 6.5l11 11M17.5 6.5l-11 11'], cap: true },
  copy: { vb: 16, d: ['M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5'], rect: [5.5, 5.5, 8, 8, 1.5], cap: true },
  fork: { vb: 16, d: ['M4 1.5v4.2a1.6 1.6 0 0 0 3.2 0V1.5M5.6 1.5v13M11.5 14.5V1.5c-1.8.6-2.6 2.6-2.6 4.8 0 1.6.9 2.4 2.6 2.4'], cap: true },
  basket: { vb: 16, d: ['M2 6h12l-1.3 7.2a1.5 1.5 0 0 1-1.5 1.3H4.8a1.5 1.5 0 0 1-1.5-1.3L2 6ZM5.5 6l2-4M10.5 6l-2-4'], cap: true },
  briefcase: { vb: 16, d: ['M5.5 4.5V3.2A1.2 1.2 0 0 1 6.7 2h2.6a1.2 1.2 0 0 1 1.2 1.2v1.3'], rect: [2, 4.5, 12, 9, 2] },
  home: { vb: 16, d: ['M2.5 7.2 8 2.5l5.5 4.7V13a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1V7.2Z', 'M6.3 14v-4h3.4v4'] },
  bolt: { vb: 16, d: ['M9 1.5 3.5 9H8l-1 5.5L12.5 7H8l1-5.5Z'] },
  wifi: { vb: 16, d: ['M2 6.2a8.5 8.5 0 0 1 12 0M4.2 8.6a5.3 5.3 0 0 1 7.6 0M6.4 11a2.2 2.2 0 0 1 3.2 0'], cap: true },
  'shield-plain': { vb: 16, d: ['M8 1.5 13.5 3.5v4.2c0 3.2-2.3 5.6-5.5 6.8-3.2-1.2-5.5-3.6-5.5-6.8V3.5L8 1.5Z'] },
  repeat: { vb: 16, d: ['M2.5 6.5A5.5 5.5 0 0 1 12.8 4M13.5 9.5A5.5 5.5 0 0 1 3.2 12M12.8 1.5V4h-2.5M3.2 14.5V12h2.5'], cap: true },
  basket24: { vb: 24, d: ['M3.5 9.5h17l-1.7 9.2a2 2 0 0 1-2 1.6H7.2a2 2 0 0 1-2-1.6z', 'M8.5 9.5 11 4.5M15.5 9.5 13 4.5M9.5 13.5V17M14.5 13.5V17'], cap: true },
  'lock-big': { vb: 24, d: ['M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5', 'M12 14.2v2.6'], rect: [5, 10.5, 14, 10, 2.6], cap: true },
  tag: { vb: 18, d: ['M2.5 9.6V3.8a1.3 1.3 0 0 1 1.3-1.3h5.8l6 6a1.3 1.3 0 0 1 0 1.8l-4.9 4.9a1.3 1.3 0 0 1-1.8 0l-6.4-5.6Z'], dots: [[6.2, 6.2, 1.2]], cap: true },
  pie: { vb: 18, d: ['M9 2.5V9l4.6 4.6', 'M9 9h6.5'], circles: [[9, 9, 6.5]], cap: true },
  bank: { vb: 18, d: ['M2.5 6.8 9 3l6.5 3.8', 'M4.3 8.5v5M7.4 8.5v5M10.6 8.5v5M13.7 8.5v5', 'M2.5 15.5h13'], cap: true },
  'eye-off': { vb: 18, d: ['M2 9s2.6-4.8 7-4.8S16 9 16 9s-2.6 4.8-7 4.8S2 9 2 9Z', 'M3 3l12 12'], circles: [[9, 9, 2.3]], cap: true },
} as const satisfies Record<
  string,
  {
    vb: number;
    d: readonly string[];
    rect?: readonly number[];
    circles?: readonly (readonly number[])[];
    dots?: readonly (readonly number[])[];
    cap?: boolean;
  }
>;

const { name, size = 16, label, class: className, stroke } = Astro.props;
const icon = ICONS[name] as {
  vb: number;
  d: readonly string[];
  rect?: readonly number[];
  circles?: readonly (readonly number[])[];
  dots?: readonly (readonly number[])[];
  cap?: boolean;
};
const sw = stroke ?? (icon.vb >= 22 ? 1.9 : icon.vb >= 18 ? 1.6 : 1.8);
const cap = icon.cap ? 'round' : undefined;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox={`0 0 ${icon.vb} ${icon.vb}`}
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap={cap}
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  {icon.rect && <rect x={icon.rect[0]} y={icon.rect[1]} width={icon.rect[2]} height={icon.rect[3]} rx={icon.rect[4]} />}
  {icon.circles?.map((c) => <circle cx={c[0]} cy={c[1]} r={c[2]} />)}
  {icon.d.map((d) => <path d={d} />)}
  {icon.dots?.map((c) => <circle cx={c[0]} cy={c[1]} r={c[2]} fill="currentColor" stroke="none" />)}
</svg>
