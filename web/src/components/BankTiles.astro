---
/** The supported banks as tiles: on the home page, and on /how-it-works with the alerts each one covers. */
import { BANKS } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  /** Show which alerts Hasala reads from each bank. */
  detail?: boolean;
  /** Home page version: logo and "Supported" chip, then the name and what is read. Extra content (slot) becomes the last tile. */
  home?: boolean;
}
const { detail = false, home = false } = Astro.props;
---

<ul class:list={['tiles', detail && 'tiles--detail', home && 'tiles--home']} role="list">
  {
    BANKS.map((b) => (
      <li class="tile" data-reveal>
        <span class:list={['tile__logo', `tile__logo--${b.value}`]} aria-hidden="true">
          {b.short}
        </span>
        <div class="tile__text">
          <h3>{b.name}</h3>
          {(detail || home) && <p>Card and account email alerts</p>}
        </div>
        {home ? (
          <span class="tile__chip">
            <Icon name="check" size={12} stroke={2.2} />
            Supported
          </span>
        ) : (
          <span class="tile__check" aria-hidden="true">
            <Icon name="check" size={16} stroke={2.2} />
          </span>
        )}
      </li>
    ))
  }
  {home && <li class="tile tile--more" data-reveal><slot /></li>}
</ul>

<style>
  .tiles {
    display: grid;
    gap: 10px;
  }
  .tile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: 24px;
    background: var(--neutral-100);
  }
  .tile__logo {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--white);
    box-shadow: rgb(0 0 0 / 4%) 0 1px 2px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tile__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tile__text h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 24px;
  }
  .tile__text p {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 20px;
  }
  .tile__check {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--success-surface);
    color: var(--success);
  }
  @media (min-width: 768px) {
    .tiles {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .tile {
      gap: 18px;
      padding: 24px;
      border-radius: 28px;
    }
    .tile__logo {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      font-size: 16px;
    }
    .tile__text h3 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 28px;
    }
    /* Beside prose (/how-it-works): narrower, so the names stay on one line. */
    .tiles--detail .tile {
      padding: 20px;
    }
    .tiles--detail .tile__text h3 {
      font-size: 18px;
      line-height: 24px;
    }
  }

  /* Home page (Paper 08 Banks): phone = one row per bank, desktop = card per bank */
  .tile__chip {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--success-surface);
    color: var(--success);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
  }
  .tile__chip :global(svg) {
    display: none;
  }
  .tiles--home .tile {
    border-radius: 22px;
  }
  .tiles--home .tile__logo {
    font-size: 14px;
  }
  .tiles--home .tile__text h3 {
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
  }
  .tiles--home .tile__text p {
    display: none;
  }
  @media (max-width: 767px) {
    .tiles--home .tile__logo {
      letter-spacing: 0;
    }
    .tiles--home .tile__logo--dib {
      font-size: 15px;
    }
    .tiles--home .tile__text h3 {
      letter-spacing: 0;
    }
  }
  .tile--more {
    display: block;
    padding: 18px;
    border: 1.5px dashed var(--neutral-300);
    background: var(--white);
  }
  @media (min-width: 768px) {
    .tiles--home .tile {
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: 40px;
      padding: 28px;
      border-radius: 28px;
    }
    .tiles--home .tile__logo {
      font-size: 17px;
    }
    .tiles--home .tile__text {
      flex: none;
      gap: 4px;
    }
    .tiles--home .tile__text h3 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 28px;
    }
    .tiles--home .tile__text p {
      display: block;
      font-size: 15px;
      line-height: 22px;
    }
    .tile--more {
      display: block;
      padding: 28px;
    }
    /* logo left, chip right, text underneath */
    .tiles--home .tile:not(.tile--more) {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas: 'logo chip' 'text text';
      align-items: center;
      row-gap: 40px;
    }
    .tiles--home .tile__logo {
      grid-area: logo;
    }
    .tiles--home .tile__chip {
      grid-area: chip;
      justify-self: end;
      gap: 6px;
      padding: 5px 12px 5px 10px;
      font-size: 13px;
      line-height: 18px;
    }
    .tile__chip :global(svg) {
      display: block;
    }
    .tiles--home .tile__text {
      grid-area: text;
    }
  }
</style>
