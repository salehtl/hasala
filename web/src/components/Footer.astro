---
import { FOOTER } from '../data/site';
import Wordmark from './Wordmark.astro';

const onHome = Astro.url.pathname === '/';
const href = (h: string) => (onHome && h.startsWith('/#') ? h.slice(1) : h);

// Paper's three columns. The site column: How it works, the privacy page and
// the invite form (Banks stays a homepage section, not a link). The pages the
// site also has (Budgeting, FAQ, Licences, ...) stay reachable from the nav, the
// sections, llms.txt and the sitemap. Legal is Paper's two links only.
const siteCol = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/how-privacy-works', label: 'How privacy works' },
  { href: '/#invite', label: 'Request an invite' },
];
const cols = [
  { title: 'Hasala', links: siteCol, site: true },
  ...FOOTER.filter((c) => c.title !== 'Hasala').map((c) => ({ title: c.title, links: c.links.filter((l) => l.href !== '/licenses'), site: false })),
];
---

<footer class="site-footer" id="site-footer">
  <div class="container footer">
    <div class="footer__top" data-reveal>
      <div class="footer__brand">
        <a href="/" aria-label="Hasala home" class="footer__home"><Wordmark id="wm-footer" img class="footer__wordmark" /></a>
        <p>A UAE budget app that fills itself in from your bank's emails.<span class="footer__only"> Only you can see it.</span></p>
      </div>
      <nav class="footer__cols" aria-label="Footer">
        {
          cols.map((col) => (
            <div class:list={['footer__col', col.site && 'footer__col--site']}>
              <p class="footer__title">{col.title}</p>
              <ul role="list">
                {col.links.map((l) => (
                  <li>
                    <a href={href(l.href)}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="footer__bottom">
      <p class="footer__meta">
        <span>© {new Date().getFullYear()} Hasala</span>
        <span class="footer__sep" aria-hidden="true">·</span>
        <span class="footer__made">Made in the UAE</span>
        <span class="footer__sep footer__sep--site" aria-hidden="true"></span>
        <span class="footer__site">hasala.app</span>
      </p>
      <div class="footer__legal">
        <p>iPhone and TestFlight are trademarks of Apple Inc. Gmail is a trademark of Google LLC. Hasala is not affiliated with any bank.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--white);
    padding: 40px 0 calc(48px + env(safe-area-inset-bottom));
  }
  .footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 360px;
  }
  .footer__home {
    align-self: flex-start;
    color: var(--text-primary);
  }
  .footer__wordmark {
    width: auto;
    height: 30px;
  }
  .footer__brand p {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 22px;
  }
  .footer__only {
    display: none;
  }
  .footer__cols {
    display: flex;
    gap: 24px;
  }
  .footer__col {
    flex: 1 1 0;
    min-width: 0;
  }
  /* Phones: Paper shows Help and Legal only; the site's own links sit in the nav. */
  .footer__col--site {
    display: none;
  }
  .footer__title {
    margin-bottom: 14px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer__col li {
    line-height: 20px;
  }
  .footer__col a {
    display: inline-block;
    color: var(--text-primary);
    font-size: 15px;
    line-height: 20px;
    transition: color var(--t-hover-out);
  }
  .footer__col a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 20px;
  }
  .footer__sep {
    padding-inline: 0.3em;
  }
  .footer__sep--site,
  .footer__site {
    display: none;
  }
  .footer__legal {
    color: var(--neutral-500);
    font-size: 12px;
    line-height: 18px;
  }
  @media (min-width: 768px) {
    .footer__col--site {
      display: block;
    }
    .footer__cols {
      gap: 40px;
    }
  }
  @media (min-width: 1024px) {
    .site-footer {
      padding: 72px 0 calc(56px + env(safe-area-inset-bottom));
    }
    .footer {
      gap: 64px;
    }
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      gap: 48px;
    }
    .footer__brand {
      flex: none;
      gap: 16px;
      width: 360px;
    }
    .footer__wordmark {
      height: 36px;
    }
    .footer__brand p {
      font-size: 16px;
      line-height: 24px;
    }
    .footer__only {
      display: inline;
    }
    .footer__cols {
      gap: 72px;
    }
    .footer__col {
      flex: none;
      width: 140px;
    }
    .footer__title {
      font-size: 13px;
    }
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding-top: 24px;
    }
    .footer__meta {
      gap: 0 16px;
    }
    .footer__sep {
      width: 3px;
      height: 3px;
      padding: 0;
      border-radius: 2px;
      background: var(--neutral-400);
      font-size: 0;
    }
    .footer__made {
      color: var(--text-primary);
      font-weight: 500;
    }
    .footer__sep--site,
    .footer__site {
      display: block;
    }
    .footer__legal {
      flex: none;
      width: 520px;
      text-align: right;
    }
  }
</style>
