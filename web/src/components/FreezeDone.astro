---
/**
 * After "Freeze my account" (Paper page 14, "Web · hasala.app/freeze · Frozen
 * (done)"), worded as in the Hasala design archive (private): the server answers the same whether or not the
 * token was valid, so this never says more than "if this link was valid".
 */
import Icon from './Icon.astro';
---

<div class="frozen">
  <div class="frozen__id">
    <span class="frozen__lock" aria-hidden="true"><Icon name="lock-big" size={52} stroke={1.8} /></span>
    <p class="frozen__from">From your Hasala security email</p>
  </div>
  <div class="frozen__head">
    <h2 class="frozen__title" tabindex="-1" data-frozen-title>If this link was valid, your account is now frozen.</h2>
    <p class="frozen__lead">Then nobody can sign in or change your keys on any device. Your budget stays sealed and nothing was deleted.</p>
  </div>
  <ol class="frozen__steps" role="list">
    <li><span class="frozen__n">1</span><span><b>Open Hasala on your iPhone</b>It shows whether your account is frozen. If it isn’t, choose Freeze my account under Sign-in &amp; security.</span></li>
    <li><span class="frozen__n">2</span><span><b>If it is frozen, sign in fully to unfreeze</b>Your passkey, or your password on one of your iPhones.</span></li>
    <li><span class="frozen__n">3</span><span><b>Lock it down</b>Sign out everywhere, remove what you don’t know, make new words.</span></li>
  </ol>
  <p class="frozen__fine">This page never asks for a password, a code or your 12 words. If one does, close it.</p>
</div>

<style>
  .frozen {
    display: flex;
    flex-direction: column;
    max-width: 720px;
    margin: 0 auto;
  }
  .frozen__id {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .frozen__lock {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(in oklab 160deg, var(--hue-rose-start), var(--hue-rose-end));
    box-shadow: #fff 0 0 0 4px;
    color: var(--hue-rose-ink);
  }
  .frozen__lock :global(svg) {
    width: 28px;
    height: 28px;
  }
  .frozen__from {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 20px;
  }
  .frozen__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 0 16px;
  }
  .frozen__title {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 46px;
    outline: none;
  }
  .frozen__lead {
    color: var(--neutral-700);
    font-size: 17px;
    line-height: 26px;
  }
  .frozen__steps {
    display: flex;
    flex-direction: column;
    padding: 4px 20px;
    border-radius: 24px;
    background: var(--white);
    box-shadow: rgb(0 0 0 / 6%) 0 0 0 0.5px, rgb(20 38 89 / 6%) 0 10px 30px;
    text-align: left;
  }
  .frozen__steps li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0;
  }
  .frozen__steps li + li {
    border-top: 1px solid var(--border-subtle);
  }
  .frozen__n {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--neutral-100);
    font-family: var(--font-figure);
    font-size: 15px;
    font-weight: 600;
    line-height: 18px;
  }
  .frozen__steps li > span:last-child {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 20px;
  }
  .frozen__steps b {
    color: var(--text-primary);
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
  }
  .frozen__fine {
    padding-top: 24px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 19px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .frozen__id {
      flex-direction: column;
      gap: 0;
    }
    .frozen__lock {
      width: 96px;
      height: 96px;
      box-shadow: #fff 0 0 0 8px, rgb(94 31 40 / 14%) 0 18px 40px;
    }
    .frozen__lock :global(svg) {
      width: 52px;
      height: 52px;
    }
    .frozen__from {
      padding-top: 28px;
      font-size: 15px;
      font-weight: 600;
    }
    .frozen__head {
      align-items: center;
      padding: 16px 0 32px;
      text-align: center;
    }
    .frozen__title {
      font-size: clamp(44px, 38.06px + 1.524vw, 60px);
      line-height: calc(1em + 4px);
    }
    .frozen__lead {
      max-width: 600px;
      font-size: clamp(17px, 16.26px + 0.19vw, 19px);
      line-height: 1.53;
    }
    .frozen__fine {
      font-size: 15px;
      line-height: 20px;
    }
  }
</style>
