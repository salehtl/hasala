---
/**
 * /how-privacy-works flow (Paper NFK-0): Your Gmail, Your iPhone, Our server,
 * A new iPhone, joined by labelled connectors. A numbered list: the cards carry
 * the whole story in text; the connectors are decoration. From 1024 it runs
 * left to right; on phones it stacks and the connectors point down.
 */
import Icon from '../Icon.astro';
---

<ol class="flow" role="list" aria-label="Where your data goes">
  <li class="flow__card flow__card--glass flow__card--side">
    <span class="flow__icon"><Icon name="mail" size={22} stroke={1.5} /></span>
    <div class="flow__text">
      <h3 class="flow__title">Your Gmail</h3>
      <p class="flow__copy">Your iPhone downloads only the emails from your bank, read‑only. The rest of your inbox is never downloaded.</p>
    </div>
    <p class="flow__pill">Google API Limited Use</p>
  </li>
  <li class="flow__hop flow__hop--blue" aria-hidden="true">
    <span class="flow__hop-label">Emails</span>
    <svg class="flow__arrow flow__arrow--dashed" viewBox="0 0 56 12" width="44" height="12">
      <path d="M1 6h50" />
      <path d="M48 1.5 53.5 6 48 10.5" />
    </svg>
  </li>
  <li class="flow__card flow__card--phone">
    <div class="flow__top">
      <span class="flow__icon flow__icon--gold"><Icon name="key" size={22} stroke={2} /></span>
      <p class="flow__holds">Holds the key</p>
    </div>
    <div class="flow__text">
      <h3 class="flow__title">Your iPhone</h3>
      <p class="flow__copy">Where all the work happens.</p>
    </div>
    <ul class="flow__checks" role="list">
      <li><Icon name="check" size={16} stroke={1.9} />Reads your bank emails</li>
      <li><Icon name="check" size={16} stroke={1.9} />Sorts and budgets</li>
      <li><Icon name="check" size={16} stroke={1.9} />Locks it before backup</li>
    </ul>
  </li>
  <li class="flow__hop flow__hop--gold" aria-hidden="true">
    <span class="flow__hop-label">Locked</span>
    <svg class="flow__arrow" viewBox="0 0 56 12" width="44" height="12">
      <path d="M1 6h50" />
      <path d="M48 1.5 53.5 6 48 10.5" />
    </svg>
  </li>
  <li class="flow__card flow__card--glass flow__card--server">
    <svg class="flow__coins" width="244" height="62" viewBox="0 0 252 64" aria-hidden="true">
      <defs>
        <linearGradient id="hpw-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F9DC94"></stop><stop offset="1" stop-color="#EBB04A"></stop></linearGradient>
        <clipPath id="hpw-c"><rect x="0" y="0" width="252" height="50"></rect></clipPath>
      </defs>
      <rect x="0" y="34" width="252" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.08"></rect>
      <rect x="8" y="41" width="236" height="16" rx="8" fill="#070E26"></rect>
      <rect x="18" y="52" width="216" height="2.5" rx="1.25" fill="#FFFFFF" opacity="0.18"></rect>
      <g clip-path="url(#hpw-c)">
        <circle cx="66" cy="36" r="20" fill="#C98A1E"></circle>
        <circle cx="66" cy="34" r="20" fill="url(#hpw-g)" opacity="0.55"></circle>
        <circle cx="126" cy="24" r="20" fill="#C98A1E"></circle>
        <circle cx="126" cy="22" r="20" fill="url(#hpw-g)"></circle>
        <path d="M118.5 18.5h15M118.5 25.5h15" stroke="#8A5A05" stroke-width="3" stroke-linecap="round"></path>
        <circle cx="186" cy="40" r="20" fill="#C98A1E"></circle>
        <circle cx="186" cy="38" r="20" fill="url(#hpw-g)" opacity="0.35"></circle>
      </g>
    </svg>
    <div class="flow__text">
      <h3 class="flow__title flow__title--row">Our server <small>behind Cloudflare</small></h3>
      <p class="flow__copy">Stores your locked data but can’t open it. Knows your email address. Never sees your emails, amounts, shops or budget.</p>
    </div>
  </li>
  <li class="flow__hop flow__hop--gold" aria-hidden="true">
    <span class="flow__hop-label">Locked</span>
    <svg class="flow__arrow" viewBox="0 0 56 12" width="44" height="12">
      <path d="M1 6h50" />
      <path d="M48 1.5 53.5 6 48 10.5" />
    </svg>
  </li>
  <li class="flow__card flow__card--glass flow__card--side">
    <span class="flow__icon"><Icon name="phone" size={22} stroke={1.5} /></span>
    <div class="flow__text">
      <h3 class="flow__title">A new iPhone</h3>
      <p class="flow__copy">Unlock your data with your passkey or your 12‑word recovery phrase.</p>
    </div>
    <p class="flow__pill">We can’t reset it for you</p>
  </li>
</ol>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 28px;
    background: rgb(255 255 255 / 6%);
    box-shadow: rgb(255 255 255 / 14%) 0 0 0 1px inset;
    color: var(--white);
  }
  .flow__card--phone {
    background: var(--white);
    box-shadow: rgb(0 0 0 / 30%) 0 24px 48px;
    color: var(--text-primary);
  }
  .flow__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgb(255 255 255 / 10%);
  }
  .flow__icon--gold {
    border-radius: 22px;
    background: var(--coin);
    box-shadow:
      rgb(201 138 30 / 50%) 0 0 0 1px inset,
      var(--gold-edge) 0 3px 0;
    color: var(--gold-ink);
  }
  .flow__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .flow__holds {
    margin: 0;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
  }
  .flow__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .flow__title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 26px;
  }
  .flow__title--row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }
  .flow__title small {
    color: rgb(255 255 255 / 60%);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 18px;
  }
  .flow__copy {
    margin: 0;
    color: rgb(255 255 255 / 72%);
    font-size: 15px;
    line-height: 22px;
  }
  .flow__card--phone .flow__copy {
    color: var(--text-secondary);
  }
  .flow__pill {
    align-self: flex-start;
    margin: 4px 0 0;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 10%);
    color: rgb(255 255 255 / 86%);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }
  .flow__checks {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    line-height: 20px;
  }
  .flow__checks :global(.icon) {
    color: var(--green-700);
  }
  .flow__coins {
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 244 / 62;
  }

  .flow__hop {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 76px;
    color: var(--amber-300);
  }
  .flow__hop--blue {
    color: var(--blue-300);
  }
  .flow__hop-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .flow__arrow {
    flex-shrink: 0;
    margin-block: 16px;
    transform: rotate(90deg);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow__arrow--dashed path:first-child {
    stroke-dasharray: 3 4;
  }
  .flow__hop {
    flex-direction: row;
  }

  @media (min-width: 1024px) {
    .flow {
      flex-direction: row;
    }
    .flow__card--side {
      flex: 222 1 0;
      min-width: 0;
    }
    .flow__card--phone,
    .flow__card--server {
      flex: 292 1 0;
      min-width: 0;
    }
    .flow__hop {
      flex-direction: column;
      width: 57px;
      height: auto;
    }
    .flow__arrow {
      margin-block: 0;
      transform: none;
    }
  }
</style>
