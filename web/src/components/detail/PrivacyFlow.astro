---
/**
 * /how-privacy-works flow (Paper NFK-0): Your Gmail, Your iPhone, Our server,
 * A new iPhone, joined by labelled connectors. A numbered list: the cards carry
 * the whole story in text; the connectors are decoration. From 1024 it runs
 * left to right; on phones it stacks and the connectors point down.
 *
 * Motion (Paper C83-0, B): when a fifth of it is in view (data-play, set by
 * the script below), the cards and arrows draw in order, 120 ms per hop; the
 * iPhone lifts in on the spring, its key turns and its checks tick in; the
 * server's coins drop into the slot. Then one token flows down each arrow
 * in turn: an email, then a locked coin, then another. With reduced
 * motion all of it is shown still and nothing moves.
 */
import Icon from '../Icon.astro';
---

<ol class="flow" role="list" aria-label="Where your data goes">
  <li data-play-in class="flow__card flow__card--glass flow__card--side">
    <span class="flow__icon"><Icon name="mail" size={22} stroke={1.5} /></span>
    <div class="flow__text">
      <h3 class="flow__title">Your Gmail</h3>
      <p class="flow__copy">Your iPhone downloads only the emails from your bank, read‑only. The rest of your inbox is never downloaded.</p>
    </div>
    <p class="flow__pill">Google API Limited Use</p>
  </li>
  <li data-play-in class="flow__hop flow__hop--blue" aria-hidden="true">
    <span class="flow__hop-label">Emails</span>
    <span class="flow__track">
      <svg class="flow__arrow flow__arrow--dashed" viewBox="0 0 56 12" width="44" height="12">
        <path d="M1 6h50" />
        <path d="M48 1.5 53.5 6 48 10.5" />
      </svg>
      <span class="flow__token"></span>
    </span>
  </li>
  <li data-play-in class="flow__card flow__card--phone">
    <div class="flow__top">
      <span class="flow__icon flow__icon--gold"><Icon name="key" size={22} stroke={2} /></span>
      <p class="flow__holds">Holds the key</p>
    </div>
    <div class="flow__text">
      <h3 class="flow__title">Your iPhone</h3>
      <p class="flow__copy">Where all the work happens.</p>
    </div>
    <ul class="flow__checks" role="list">
      <li><Icon name="check" size={16} stroke={1.9} />Reads your bank emails</li>
      <li><Icon name="check" size={16} stroke={1.9} />Sorts and budgets</li>
      <li><Icon name="check" size={16} stroke={1.9} />Locks it before backup</li>
    </ul>
  </li>
  <li data-play-in class="flow__hop flow__hop--gold" aria-hidden="true">
    <span class="flow__hop-label">Locked</span>
    <span class="flow__track">
      <svg class="flow__arrow" viewBox="0 0 56 12" width="44" height="12">
        <path d="M1 6h50" />
        <path d="M48 1.5 53.5 6 48 10.5" />
      </svg>
      <span class="flow__token"></span>
    </span>
  </li>
  <li data-play-in class="flow__card flow__card--glass flow__card--server">
    <svg class="flow__coins" width="244" height="62" viewBox="0 0 252 64" aria-hidden="true">
      <defs>
        <linearGradient id="hpw-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F9DC94"></stop><stop offset="1" stop-color="#EBB04A"></stop></linearGradient>
        <clipPath id="hpw-c"><rect x="0" y="-80" width="252" height="130"></rect></clipPath>
      </defs>
      <rect x="0" y="34" width="252" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.08"></rect>
      <rect class="flow__slot" x="8" y="41" width="236" height="16" rx="8" fill="#070E26"></rect>
      <rect x="18" y="52" width="216" height="2.5" rx="1.25" fill="#FFFFFF" opacity="0.18"></rect>
      <g clip-path="url(#hpw-c)">
        <g class="flow__coin">
          <circle cx="66" cy="36" r="20" fill="#C98A1E"></circle>
          <circle cx="66" cy="34" r="20" fill="url(#hpw-g)" opacity="0.55"></circle>
        </g>
        <g class="flow__coin">
          <circle cx="126" cy="24" r="20" fill="#C98A1E"></circle>
          <circle cx="126" cy="22" r="20" fill="url(#hpw-g)"></circle>
          <path d="M118.5 18.5h15M118.5 25.5h15" stroke="#8A5A05" stroke-width="3" stroke-linecap="round"></path>
        </g>
        <g class="flow__coin">
          <circle cx="186" cy="40" r="20" fill="#C98A1E"></circle>
          <circle cx="186" cy="38" r="20" fill="url(#hpw-g)" opacity="0.35"></circle>
        </g>
      </g>
    </svg>
    <div class="flow__text">
      <h3 class="flow__title flow__title--row">Our server <small>behind Cloudflare</small></h3>
      <p class="flow__copy">Stores your locked data but can’t open it. Knows your email address. Never sees your emails, amounts, shops or budget.</p>
    </div>
  </li>
  <li data-play-in class="flow__hop flow__hop--gold" aria-hidden="true">
    <span class="flow__hop-label">Locked</span>
    <span class="flow__track">
      <svg class="flow__arrow" viewBox="0 0 56 12" width="44" height="12">
        <path d="M1 6h50" />
        <path d="M48 1.5 53.5 6 48 10.5" />
      </svg>
      <span class="flow__token"></span>
    </span>
  </li>
  <li data-play-in class="flow__card flow__card--glass flow__card--side">
    <span class="flow__icon"><Icon name="phone" size={22} stroke={1.5} /></span>
    <div class="flow__text">
      <h3 class="flow__title">A new iPhone</h3>
      <p class="flow__copy">Unlock your data with your passkey or your 12‑word recovery phrase.</p>
    </div>
    <p class="flow__pill">We can’t reset it for you</p>
  </li>
</ol>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 28px;
    background: rgb(255 255 255 / 6%);
    box-shadow: rgb(255 255 255 / 14%) 0 0 0 1px inset;
    color: var(--white);
  }
  .flow__card--phone {
    background: var(--white);
    box-shadow: rgb(0 0 0 / 30%) 0 24px 48px;
    color: var(--text-primary);
  }
  .flow__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgb(255 255 255 / 10%);
  }
  .flow__icon--gold {
    border-radius: 22px;
    background: var(--coin);
    box-shadow:
      rgb(201 138 30 / 50%) 0 0 0 1px inset,
      var(--gold-edge) 0 3px 0;
    color: var(--gold-ink);
  }
  .flow__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .flow__holds {
    margin: 0;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
  }
  .flow__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .flow__title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 26px;
  }
  .flow__title--row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }
  .flow__title small {
    color: rgb(255 255 255 / 60%);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 18px;
  }
  .flow__copy {
    margin: 0;
    color: rgb(255 255 255 / 72%);
    font-size: 15px;
    line-height: 22px;
  }
  .flow__card--phone .flow__copy {
    color: var(--text-secondary);
  }
  .flow__pill {
    align-self: flex-start;
    margin: 4px 0 0;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 10%);
    color: rgb(255 255 255 / 86%);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }
  .flow__checks {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    line-height: 20px;
  }
  .flow__checks :global(.icon) {
    color: var(--green-700);
  }
  .flow__coins {
    display: block;
    overflow: visible;
    max-width: 100%;
    height: auto;
    aspect-ratio: 244 / 62;
  }

  .flow__hop {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 76px;
    color: var(--amber-300);
  }
  .flow__hop--blue {
    color: var(--blue-300);
  }
  .flow__hop-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .flow__track {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 44px;
    height: 12px;
    margin-block: 16px;
    transform: rotate(90deg);
  }
  .flow__arrow {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow__arrow--dashed path:first-child {
    stroke-dasharray: 3 4;
  }
  .flow__hop {
    flex-direction: row;
  }

  @media (min-width: 1024px) {
    .flow {
      flex-direction: row;
    }
    .flow__card--side {
      flex: 222 1 0;
      min-width: 0;
    }
    .flow__card--phone,
    .flow__card--server {
      flex: 292 1 0;
      min-width: 0;
    }
    .flow__hop {
      flex-direction: column;
      width: 57px;
      height: auto;
    }
    .flow__track {
      margin-block: 0;
      transform: none;
    }
  }
  /* The token that flows down each arrow: an email (blue), a locked coin (gold). */
  .flow__token {
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
    opacity: 0;
    pointer-events: none;
  }
  .flow__hop--gold .flow__token {
    width: 10px;
    height: 10px;
    margin-top: -5px;
    background: var(--coin);
    box-shadow:
      var(--gold-edge) 0 1.5px 0,
      0 0 10px rgb(241 202 120 / 60%);
  }

  /*
   * Motion. Hidden only while JS runs and motion is allowed, until the script
   * sets data-play on each item as it comes into view; with reduced motion (or
   * no JS) the diagram is simply there. Reveals: 480 ms ease-out-soft, rise
   * 24 px; the iPhone lifts on the spring. From 1024 the whole row is in view
   * at once, so the items draw left to right, 120 ms per hop (--k); stacked on
   * a phone, each draws as it scrolls in.
   */
  @media (prefers-reduced-motion: no-preference) {
    .flow > li {
      --k: 0;
    }
    .flow__hop:nth-child(4) {
      --h: 1;
    }
    .flow__hop:nth-child(6) {
      --h: 2;
    }

    :global(.js) .flow > .flow__card:not([data-play]),
    :global(.js) .flow > li:not([data-play]) .flow__hop-label,
    :global(.js) .flow > li:not([data-play]) .flow__coin,
    :global(.js) .flow > li:not([data-play]) .flow__holds,
    :global(.js) .flow > li:not([data-play]) .flow__checks li {
      opacity: 0;
    }
    :global(.js) .flow > li:not([data-play]) .flow__arrow {
      clip-path: inset(0 100% 0 0);
    }

    .flow > .flow__card[data-play] {
      animation: flow-rise var(--t-reveal) var(--ease-out-soft) calc(var(--k) * 120ms) both;
    }
    .flow > .flow__card--phone[data-play] {
      animation: flow-lift 760ms var(--ease-spring) calc(var(--k) * 120ms) both;
    }
    .flow__hop[data-play] .flow__hop-label {
      animation: flow-fade 320ms var(--ease-out-soft) calc(var(--k) * 120ms + 80ms) both;
    }
    .flow__hop[data-play] .flow__arrow {
      animation: flow-draw 360ms var(--ease-out-soft) calc(var(--k) * 120ms) both;
    }

    /* The iPhone: the key turns, "Holds the key" pops, the checks tick in. */
    .flow__card--phone[data-play] .flow__icon--gold {
      animation: flow-turn 640ms var(--ease-spring) calc(var(--k) * 120ms + 280ms) both;
    }
    .flow__card--phone[data-play] .flow__holds {
      animation: flow-pop 420ms var(--ease-spring) calc(var(--k) * 120ms + 400ms) both;
    }
    .flow__card--phone[data-play] .flow__checks li {
      animation: flow-tick 320ms var(--ease-out-soft) calc(var(--k) * 120ms + 480ms + var(--c, 0) * 90ms) both;
    }
    .flow__checks li:nth-child(2) {
      --c: 1;
    }
    .flow__checks li:nth-child(3) {
      --c: 2;
    }

    /* The server: the coins drop into the slot, one after another. */
    .flow__card--server[data-play] .flow__coin {
      animation: flow-drop 620ms var(--ease-spring) calc(var(--k) * 120ms + 300ms + var(--c, 0) * 110ms) both;
    }
    .flow__coin:nth-child(2) {
      --c: 1;
    }
    .flow__coin:nth-child(3) {
      --c: 2;
    }

    /* Then the data flows: each arrow carries one token, in turn, and the
       diagram is still again within 5 s (WCAG 2.2.2). */
    .flow__hop[data-play] .flow__token {
      animation: flow-token 3600ms var(--ease-in-out) calc(1200ms + var(--h, 0) * 600ms) 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
    .flow > li:nth-child(2) {
      --k: 1;
    }
    .flow > li:nth-child(3) {
      --k: 2;
    }
    .flow > li:nth-child(4) {
      --k: 3;
    }
    .flow > li:nth-child(5) {
      --k: 4;
    }
    .flow > li:nth-child(6) {
      --k: 5;
    }
    .flow > li:nth-child(7) {
      --k: 6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow__token {
      display: none;
    }
  }

  @keyframes flow-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes flow-lift {
    from {
      opacity: 0;
      transform: translateY(48px) scale(0.94);
      box-shadow: rgb(0 0 0 / 0%) 0 4px 8px;
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
      box-shadow: rgb(0 0 0 / 30%) 0 24px 48px;
    }
  }
  @keyframes flow-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes flow-draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes flow-turn {
    from {
      transform: rotate(-70deg) scale(0.8);
    }
    to {
      transform: none;
    }
  }
  @keyframes flow-pop {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes flow-tick {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes flow-drop {
    from {
      opacity: 0;
      transform: translateY(-56px);
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes flow-token {
    0% {
      opacity: 0;
      transform: translateX(0) scale(0.6);
    }
    6% {
      opacity: 1;
      transform: translateX(2px) scale(1);
    }
    24% {
      opacity: 1;
      transform: translateX(30px) scale(1);
    }
    30%,
    100% {
      opacity: 0;
      transform: translateX(34px) scale(0.6);
    }
  }
</style>

<script>
  /* Sets data-play on each [data-play-in] once a fifth of it is in view (the
     diagram's cards and arrows, the who-can-see rows). Without
     IntersectionObserver it plays at once; with reduced motion the CSS keeps
     everything still whatever this sets. */
  import { onPage, observe } from '../../scripts/page';

  onPage((signal) => {
    const els = document.querySelectorAll('[data-play-in]');
    const io = observe(
      signal,
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          obs.unobserve(e.target);
          e.target.setAttribute('data-play', '');
        }
      },
      { threshold: 0.2 },
    );
    els.forEach((el) => (io ? io.observe(el) : el.setAttribute('data-play', '')));
  });
</script>
