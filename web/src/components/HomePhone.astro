        <span class="hp__tab hp__tab--on">
          <svg width="24" height="24" viewBox="0 0 24 24"><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path d="M10 21v-6.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V21" fill="#FFFFFF"></path></svg>
          Home
        </span>
        <span class="hp__tab">
          <svg width="24" height="24" viewBox="0 0 24 24"><path d="M10.6 4.2a8.9 8.9 0 1 0 9.2 9.2h-9.2z"></path><path d="M13 2.1v8.9h8.9A8.9 8.9 0 0 0 13 2.1Z"></path></svg>
          Plan
        </span>
        <span class="hp__tab">
          <svg width="24" height="24" viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="3" rx="1.5" opacity=".45"></rect><rect x="4.5" y="6.5" width="15" height="3" rx="1.5" opacity=".7"></rect><rect x="3" y="10.5" width="18" height="11" rx="3"></rect></svg>
          Review
