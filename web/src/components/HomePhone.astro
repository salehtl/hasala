        <svg width="26" height="26" viewBox="0 0 24 24" class="hp__stroke"><circle cx="10.5" cy="10.5" r="6.5" stroke-width="2.2"></circle><path d="M15.5 15.5 20 20" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </span>
      <span class="hp__home-bar"></span>
    </div>
  </div>
</div>

<script>
  import { onPage, observe } from '../scripts/page';

  // The figure counts up with the month bar (motion moment C: 900 ms,
  // ease-in-out, from 300 ms), on the bar's clock, only while the CSS
  // entrance has yet to reach it; and
  // every [data-alive] stage pauses its idle float while off screen.
  onPage((signal) => {
    const io = observe(signal, (es) => es.forEach((e) => e.target.classList.toggle('is-off', !e.isIntersecting)));
    document.querySelectorAll('[data-alive]').forEach((el) => io?.observe(el));
    document.querySelectorAll<HTMLElement>('[data-hp-count]').forEach((el) => {
      if (!getComputedStyle(el).getPropertyValue('--hp-rise').trim()) return;
      const to = Number(el.dataset.hpCount);
      const fmt = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      // Keep to the bar's own clock: a late script must not reset a figure
      // the visitor has already seen, so past the 300 ms delay it stays put.
      const wipe = el.closest('.hp')?.querySelector('.hp__fill')?.getAnimations()[0];
      const at = Number(wipe?.currentTime ?? Infinity);
      if (!(at <= 300)) return;
      const t0 = performance.now() - at + 300;
      const step = (now: number) => {
        if (signal.aborted) return;
        const t = Math.max(0, Math.min(1, (now - t0) / 900));
        const k = t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;
        el.textContent = fmt.format(to * k);
        if (t < 1) requestAnimationFrame(step);
      };
      step(performance.now());
    });
  });
</script>

<style>
  .hp {
    position: relative;
    width: 418px;
  }
  .hp__device {
    width: 418px;
    padding: 8px;
    border-radius: 62px;
    background: #0d0d10;
    box-shadow: #3a3a40 0 0 0 1.5px inset, rgb(20 30 70 / 25%) 0 30px 60px;
  }
  .hp__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 402px;
    height: 884px;
    overflow: clip;
    border-radius: 54px;
    background: var(--neutral-100);
    color: var(--text-primary);
    font-family: var(--font-sans);
    white-space: nowrap;
    container-type: inline-size;
    -webkit-font-smoothing: antialiased;
  }
  .hp svg {
    display: block;
    flex: none;
  }
  .hp__stroke {
    fill: none;
    stroke: #1a1a1a;
    stroke-width: 1.9;
  }
  .hp__stroke--2 {
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hp__wash {
    position: absolute;
    inset: 0 0 auto;
    height: 420px;
    background: linear-gradient(in oklab 180deg, oklab(91.9% -0.01 -0.038) 0%, oklab(94.1% -0.003 -0.021) 38%, oklab(95.3% 0.0007 -0.003 / 0%) 100%);
  }

  /* Status bar, 62 high */
  /* Two equal halves either side of the island, each item centred in its half. */
  .hp__status {
    position: relative;
    display: flex;
    align-items: center;
    gap: 154px;
    height: 62px;
    padding: 21px 24px 19px;
  }
  .hp__time,
  .hp__bars {
    flex: 1 1 0;
    text-align: center;
  }
  .hp__time {
    font-family: -apple-system, 'SF Pro Text', var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
  }
  .hp__island {
    position: absolute;
    top: 11px;
    left: 138px;
    width: 126px;
    height: 37px;
    border-radius: 999px;
    background: #000;
  }
  .hp svg.hp__bars {
    flex: 1 1 0;
    fill: #000;
  }

  /* Header: eye, mark, bell, avatar */
  .hp__header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 20px 0;
  }
  .hp__header-end {
    display: flex;
    gap: 10px;
  }
  /* Liquid glass, drawn without backdrop-filter (the wash behind is flat). */
  .hp__glass {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: linear-gradient(in oklab 135deg, rgb(255 255 255 / 92%), rgb(255 255 255 / 70%));
    box-shadow:
      rgb(255 255 255 / 90%) 1.5px 1.5px 1px -0.5px inset,
      rgb(255 255 255 / 45%) 0 0 0 0.5px inset,
      rgb(0 0 0 / 10%) 0 6px 16px,
      rgb(0 0 0 / 7%) 0 1px 2px,
      rgb(0 0 0 / 8%) 0 0 0 0.5px;
  }
  .hp__mark {
    position: absolute;
    top: 13px;
    left: 174px;
  }
  .hp__badge {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 6px;
    border-radius: 10px;
    background: var(--red-700);
    box-shadow: #fff 0 0 0 2px;
    color: #fff;
    font-family: var(--font-figure);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
  }
  .hp__badge--bell {
    top: -3px;
    left: 29px;
  }
  .hp__badge--tab {
    top: 5px;
    left: 39px;
    min-width: 18px;
    height: 18px;
    padding-inline: 5px;
    border-radius: 9px;
    font-size: 11px;
    line-height: 14px;
  }
  .hp__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: linear-gradient(in oklab 145deg, oklab(82.1% 0.042 0.111) 0%, oklab(75.6% 0.086 0.05) 55%, oklab(59.2% 0.064 -0.1) 100%);
    color: #2a1f3d;
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
  }

  /* Content */
  .hp__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 20px;
  }
  .hp__top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 20px 0;
  }
  .hp__spent {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hp__overline {
    color: var(--neutral-700);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .hp__figure-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .hp__unit {
    font-family: var(--font-figure);
    font-size: 20px;
    font-weight: 600;
    line-height: 24px;
  }
  /* 56 at the 402-wide screen; shrinks with it, never wraps. */
  .hp__figure {
    font-family: var(--font-figure);
    font-size: min(56px, 13.9cqi);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.021em;
    line-height: 58px;
  }
  .hp__of {
    color: var(--neutral-700);
    font-size: 17px;
    line-height: 24px;
  }

  .hp__month {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hp__bar {
    position: relative;
    height: 16px;
  }
  .hp__track,
