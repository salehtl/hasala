            <span class="hp__tile hp__in"><span>Needs</span><b>9,040.80</b></span>
            <span class="hp__tile hp__in"><span>Wants</span><b>1,247.54</b></span>
            <span class="hp__tile hp__in"><span>Savings</span><b>5,000.00</b></span>
          </div>
        </div>

        <div class="hp__widgets">
          <div class="hp__widgets-head hp__in"><span>Your widgets</span><span class="hp__edit">Edit</span></div>

          <div class="hp__w hp__pace hp__in">
            <div class="hp__w-head">
              <span class="hp__w-title">
                <span class="hp__pace-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24"><path d="M10.6 4.2a8.9 8.9 0 1 0 9.2 9.2h-9.2z"></path><path d="M13 2.1v8.9h8.9A8.9 8.9 0 0 0 13 2.1Z"></path></svg>
                </span>
                Budget pace
              </span>
              <span class="hp__muted">32% of October gone</span>
            </div>
            <div class="hp__bucket">
              <div class="hp__bucket-row">
                <span class="hp__bucket-name"><span class="hp__chip hp__chip--needs"></span><b>Needs</b><span class="hp__muted">9,040.80 of 12,350</span></span>
                <b class="hp__num">3,309.20 left</b>
              </div>
              <span class="hp__mini"><span class="hp__mini-fill hp__mini-fill--needs"></span></span>
            </div>
            <div class="hp__bucket">
              <div class="hp__bucket-row">
                <span class="hp__bucket-name"><span class="hp__chip hp__chip--wants"></span><b>Wants</b><span class="hp__muted">1,247.54 of 6,650</span></span>
                <b class="hp__num">5,402.46 left</b>
              </div>
              <span class="hp__mini"><span class="hp__mini-fill hp__mini-fill--wants"></span></span>
            </div>
            <div class="hp__bucket">
              <div class="hp__bucket-row">
                <span class="hp__bucket-name"><span class="hp__chip hp__chip--savings"></span><b>Savings</b><span class="hp__muted">5,000 of 5,000</span></span>
