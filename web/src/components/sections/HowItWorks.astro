---
/**
 * The home page's "How it works": three steps, one line each. The detail
 * (the sort order, sign-in, the swipe deck) is on /how-it-works.
 */
import Icon from '../Icon.astro';
import MoreLink from '../MoreLink.astro';
---

<section id="how-it-works" class="how" aria-labelledby="how-title">
  <div class="container how__inner">
    <h2 id="how-title" class="display-l" data-reveal>How it works</h2>

    <ol class="steps" role="list">
      <li class="step" data-reveal>
        <div class="step__top">
          <span class="coin-badge">1</span>
          <span class="disc disc--sky disc--40" aria-hidden="true"><Icon name="mail" size={18} stroke={1.6} /></span>
        </div>
        <h3 class="step__title">Connect your Gmail</h3>
        <p>Hasala looks only at your bank’s alert emails, on your iPhone. It can’t send, change or delete any mail.</p>
      </li>

      <li class="step" data-reveal>
        <div class="step__top">
          <span class="coin-badge">2</span>
          <span class="disc disc--lilac disc--40" aria-hidden="true"><Icon name="tag" size={18} stroke={1.6} /></span>
        </div>
        <h3 class="step__title">Check the categories</h3>
        <p>Each alert becomes a transaction. Hasala sorts most of them into categories. You confirm the rest.</p>
      </li>

      <li class="step" data-reveal>
        <div class="step__top">
          <span class="coin-badge">3</span>
          <span class="disc disc--mint disc--40" aria-hidden="true"><Icon name="pie" size={18} stroke={1.6} /></span>
        </div>
        <h3 class="step__title">See where it went</h3>
        <p>What you spent and on what, what’s left, and <a class="link" href="/budgeting">a simple plan for the month</a>.</p>
      </li>
    </ol>

    <MoreLink href="/how-it-works">More on how it works</MoreLink>
  </div>
</section>

<style>
  .how {
    padding: 32px 0 88px;
    background: var(--white);
  }
  .how__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .steps {
    display: grid;
    gap: 12px;
    width: 100%;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 28px;
    background: var(--neutral-100);
  }
  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
  }
  .step__title {
    font-size: var(--t-card-title);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .step p {
    color: var(--text-body);
    font-size: 17px;
    line-height: 26px;
  }
  @media (min-width: 1024px) {
    .how {
      padding: 120px 0 140px;
    }
    .how__inner {
      gap: 48px;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .step {
      padding: 32px;
      gap: 12px;
    }
  }
</style>
