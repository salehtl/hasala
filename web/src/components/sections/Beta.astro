---
/**
 * 10 Beta · Request an invite (Paper B58-0 desktop, BUS-0 phone). The pace-blue
 * panel: copy on the left (beta chip, H2, subline, three requirements), the
 * coin over its slot and the form card on the right. On phones the copy is
 * shorter (no "so we can fix problems quickly", no requirements list) and the
 * form follows in one column. The form's states live in WaitlistForm.astro.
 */
import WaitlistForm from '../WaitlistForm.astro';
import Icon from '../Icon.astro';
import { MAIL } from '../../data/site';
---

<section id="invite" class="beta" aria-labelledby="beta-title">
  <div class="container-wide">
    <div class="panel panel--pace beta__panel">
      <div class="beta__glow section__glow" aria-hidden="true"></div>
      <div class="beta__copy" data-reveal>
        <p class="chip chip--glass beta__chip"><span class="beta__dot" aria-hidden="true"></span>Private beta on TestFlight</p>
        <h2 id="beta-title" class="display-beta">Get an invite.</h2>
        <p class="beta__lead">
          We’re letting people in a few at a time<span class="beta__more">, so we can fix problems quickly</span>. Leave your email and bank, and we’ll send you an invite when there’s a spot.
        </p>
        <ul class="beta__needs">
          <li><Icon name="check" size={16} stroke={1.9} />iPhone with iOS 26 or later</li>
          <li><Icon name="check" size={16} stroke={1.9} />An email account that gets your bank’s emails ({MAIL} today)</li>
          <li><Icon name="check" size={16} stroke={1.9} />English only for now. Expect a few bugs</li>
        </ul>
      </div>
      <div class="beta__form" data-reveal>
        <WaitlistForm />
      </div>
    </div>
  </div>
</section>

<style>
  .beta {
    padding: 0 0 40px;
    background: var(--white);
  }
  .beta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Paper BUS-0: 48 top, 12 sides, 12 bottom on phones. */
    padding-bottom: 12px;
  }
  /* Glow behind the coin (desktop only; the phone panel has none). */
  .beta__glow {
    display: none;
    right: -104px;
    top: -200px;
    width: 640px;
    height: 560px;
    background: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(90.3% 0.003 0.096 / 35%) 0%, oklab(90.3% 0.003 0.096 / 0%) 65%);
  }
  .beta__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 560px;
    padding: 0 12px 28px;
  }
  .beta__chip {
    align-self: flex-start;
    min-height: 0;
    padding: 6px 12px 6px 10px;
    background: rgb(255 255 255 / 16%);
    box-shadow: none;
    color: var(--white);
    font-size: 13px;
  }
  .beta__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-100);
  }
  .beta__lead {
    color: rgb(255 255 255 / 88%);
    font-size: 16px;
    line-height: 25px;
  }
  .beta__more,
  .beta__needs {
    display: none;
  }
  .beta__needs {
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
  }
  .beta__needs li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 92%);
    font-size: 16px;
    line-height: 22px;
  }
  .beta__needs :global(.icon) {
    flex: none;
    color: var(--gold-100);
  }
  .beta__form {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 520px;
  }
  .beta :global(:focus-visible) {
    outline-color: var(--white);
  }
  .beta :global(.wl-card :focus-visible) {
    outline-color: var(--blue-600);
  }

  @media (min-width: 768px) {
    .beta__chip {
      padding-right: 14px;
      font-size: 14px;
    }
    .beta__dot {
      width: 8px;
      height: 8px;
    }
    .beta__copy {
      gap: 20px;
      padding: 0 0 40px;
    }
    .beta__lead {
      font-size: 19px;
      line-height: 30px;
    }
    .beta__more,
    .beta__needs {
      display: inline;
    }
    .beta__needs {
      display: flex;
    }
  }
  @media (min-width: 1024px) {
    .beta {
      padding-bottom: 72px;
    }
    .beta__glow {
      display: block;
    }
    .beta__panel {
      --pad-panel-x: clamp(40px, 5vw, 72px);
      padding-bottom: var(--pad-panel-y);
      display: grid;
      grid-template-columns: minmax(0, 520px) minmax(0, 520px);
      align-items: center;
      justify-content: space-between;
      gap: 64px;
    }
    .beta__copy {
      max-width: none;
      padding: 0;
    }
    .beta__form {
      max-width: none;
    }
  }

  /* As the form arrives (scrolled in, not already on screen) the coin drops
     from above and settles into its slot; the slot's clip swallows the
     overshoot. Only here, not on /joined or the confirm pages. `translate`
     composes with the coin's focus lift (transform). SVG user units. */
  @media (prefers-reduced-motion: no-preference) {
    .beta__form:global(.is-scrolled-in) :global(.wl-coin-body) {
      animation: wl-settle 640ms 240ms both;
    }
  }
  @keyframes wl-settle {
    0% {
      opacity: 0;
      translate: 0 -240px;
      animation-timing-function: cubic-bezier(0.5, 0, 1, 1);
    }
    15% {
      opacity: 1;
    }
    50% {
      translate: 0 40px;
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
    }
    75% {
      translate: 0 -12px;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); /* --ease-in-out: var() is not read inside @keyframes */
    }
    100% {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
