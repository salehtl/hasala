---
/**
 * The banks Hasala reads today. Other banks are asked for in the invite form
 * below ("Another bank", then its name).
 */
import BankTiles from '../BankTiles.astro';
---

<section id="banks" class="banks" aria-labelledby="banks-title">
  <div class="container banks__inner">
    <h2 id="banks-title" class="display-l" data-reveal>Banks that work today</h2>
    <BankTiles />
    <p class="banks__other" data-reveal>
      Use a different bank? <a class="link" href="#invite">Choose “Another bank” in the form below.</a>
    </p>
  </div>
</section>

<style>
  .banks {
    padding: 88px 0 64px;
    background: var(--white);
  }
  .banks__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .banks__other {
    max-width: 640px;
    color: var(--text-body);
    font-size: 17px;
    line-height: 26px;
  }
  @media (min-width: 1024px) {
    .banks {
      padding: 120px 0 112px;
    }
    .banks__inner {
      gap: 40px;
    }
    .banks__other {
      font-size: 18px;
      line-height: 28px;
    }
  }
</style>
