---
/**
 * The home page's "Private and secure": three plain points. The data-flow
 * diagram and "who can see what" are on /how-privacy-works.
 */
import Icon from '../Icon.astro';
import MoreLink from '../MoreLink.astro';
---

<section id="privacy" class="privacy" aria-labelledby="privacy-title">
  <div class="privacy__glow" aria-hidden="true"></div>
  <div class="container privacy__inner">
    <h2 id="privacy-title" class="privacy__title" data-reveal>Private and secure</h2>

    <ul class="points" role="list">
      <li class="point" data-reveal>
        <span class="point__icon" aria-hidden="true"><Icon name="lock" size={20} stroke={1.7} /></span>
        <p><strong>Encrypted on your iPhone.</strong> Only your devices have the key, so our server can’t read your transactions or budget.</p>
      </li>
      <li class="point" data-reveal>
        <span class="point__icon" aria-hidden="true"><Icon name="bank" size={20} stroke={1.6} /></span>
        <p><strong>No bank login.</strong> Hasala never asks for your bank password and can’t move your money.</p>
      </li>
      <li class="point" data-reveal>
        <span class="point__icon" aria-hidden="true"><Icon name="eye-off" size={20} stroke={1.6} /></span>
        <p><strong>No ads or tracking.</strong> The app has no ads or analytics, and we never sell your data.</p>
      </li>
    </ul>

    <MoreLink href="/how-privacy-works" onDark>How privacy works</MoreLink>
  </div>
</section>

<style>
  .privacy {
    position: relative;
    padding: 72px 0;
    background: var(--wash-navy);
    color: var(--white);
    overflow: clip;
  }
  /* The default blue-600 ring is too dark on navy; a light ring reaches 3:1. */
  .privacy :global(:focus-visible) {
    outline-color: var(--blue-300);
  }
  .privacy__glow {
    position: absolute;
    left: calc(50% - 300px);
    top: -240px;
    width: 600px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(62.2% -0.006 -0.203 / 35%) 0%, oklab(62.2% -0.006 -0.203 / 0%) 70%);
    pointer-events: none;
  }
  .privacy__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }
  .privacy__title {
    font-size: var(--t-display-l);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: calc(1em + 4px);
  }
  .points {
    display: grid;
    gap: 12px;
    width: 100%;
  }
  .point {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 28px;
    background: rgb(255 255 255 / 6%);
    box-shadow: rgb(255 255 255 / 14%) 0 0 0 1px inset;
  }
  .point__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgb(255 255 255 / 10%);
    color: var(--gold-100);
  }
  .point p {
    color: rgb(255 255 255 / 80%);
    font-size: 17px;
    line-height: 26px;
  }
  .point strong {
    display: block;
    color: var(--white);
    font-size: var(--t-card-title);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    padding-bottom: 6px;
  }
  @media (min-width: 1024px) {
    .privacy {
      padding: 120px 0;
    }
    .privacy__inner {
      gap: 48px;
    }
    .points {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .point {
      padding: 32px;
    }
  }
</style>
