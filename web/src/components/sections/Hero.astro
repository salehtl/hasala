---
import { Picture } from 'astro:assets';
import homeScreen from '../../assets/screens/home-screen.png';
import AppIcon from '../brand/AppIcon.astro';
import Icon from '../Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow hero__glow--dirham" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--lilac" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <div class="hero__badge">
        <span class="hero__icon"><AppIcon id="hero-icon" size={84} /></span>
        <p class="hero__eyebrow">For iPhone, in the UAE</p>
      </div>

      <h1 id="hero-title" class="hero__title">See where your money goes, automatically.</h1>

      <p class="lead hero__lead">Hasala turns your bank’s alert emails into a simple budget on your iPhone. It’s private: only you can see it.</p>

      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg hero__cta" href="#invite" data-invite-cta>
          Request an invite
          <span class="btn__disc" aria-hidden="true"><Icon name="arrow-right" size={16} stroke={1.9} /></span>
        </a>
        <p class="hero__free">Free during the beta.</p>
      </div>
    </div>

    <div class="hero__stage">
      <div class="device" data-parallax>
        <Picture
          src={homeScreen}
          formats={['avif', 'webp']}
          widths={[402, 804]}
          sizes="402px"
          width={402}
          height={884}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="device__screen"
          alt="Hasala on iPhone: AED 7,417.55 left for everyday spending on day 10 of October, on track at about AED 337 a day, with six transactions to sort and a car insurance bill that looks late."
        />
      </div>
    </div>
  </div>
  <div class="hero__fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--wash-hero);
  }
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero__glow--dirham {
    width: 640px;
    height: 640px;
    left: calc(50% + 100px);
    top: 180px;
    background: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(90.3% 0.003 0.096 / 55%) 0%, oklab(90.3% 0.003 0.096 / 18%) 38%, oklab(90.3% 0.003 0.096 / 0%) 70%);
  }
  .hero__glow--lilac {
    width: 720px;
    height: 520px;
    left: calc(50% - 920px);
    top: 560px;
    background: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(87.6% 0.027 -0.043 / 55%) 0%, oklab(87.6% 0.027 -0.043 / 0%) 68%);
  }
  .hero__inner {
    position: relative;
    padding-top: 112px;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
  }
  .hero__badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 24px;
  }
  .hero__icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    box-shadow: rgb(20 38 89 / 26%) 0 10px 22px;
  }
  .hero__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .hero__eyebrow {
    color: var(--text-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }
  /* One sentence that says what Hasala is: smaller than the old two-line
     tagline, so it fits in three lines on a desktop. */
  .hero__title {
    max-width: 15em;
    font-size: clamp(40px, 30.34px + 2.476vw, 66px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .hero__lead {
    max-width: 560px;
    padding-top: 20px;
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding-top: 28px;
  }
  .hero__cta {
    --btn-h: 56px;
    font-size: 17px;
  }
  .hero__free {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 20px;
    text-align: center;
  }

  /* Phone stage: full-bleed and cropped on small screens */
  .hero__stage {
    position: relative;
    height: 520px;
    margin: 40px calc(-1 * var(--gutter)) 0;
    overflow: clip;
  }
  .device {
    position: absolute;
    left: 50%;
    top: 24px;
    width: 418px;
    margin-left: -209px;
    padding: 8px;
    border-radius: 62px;
    background: #0d0d10;
    box-shadow: #3a3a40 0 0 0 1.5px inset, rgb(20 30 70 / 25%) 0 30px 60px;
    will-change: transform;
    scale: 0.86;
    transform-origin: top center;
  }
  .device :global(img) {
    display: block;
    width: 402px;
    height: 884px;
    border-radius: 54px;
    background: var(--neutral-100);
  }
  .hero__fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(in oklab 180deg, oklab(100% 0 0 / 0%) 0%, oklab(100% 0 0 / 85%) 62%, oklab(100% 0 0) 100%);
    pointer-events: none;
    z-index: 4;
  }

  @media (min-width: 640px) {
    .hero__ctas {
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
    .hero__free {
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 940px;
    }
    .hero__inner {
      min-height: 940px;
      padding-top: 200px;
    }
    .hero__copy {
      width: 600px;
    }
    .hero__badge {
      gap: 16px;
      padding-bottom: 32px;
    }
    .hero__icon {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      box-shadow: rgb(20 38 89 / 28%) 0 14px 30px, rgb(20 38 89 / 12%) 0 2px 6px;
    }
    .hero__eyebrow {
      font-size: 17px;
      line-height: 24px;
    }
    .hero__lead {
      padding-top: 28px;
      line-height: 31px;
    }
    .hero__ctas {
      gap: 24px;
      padding-top: 40px;
    }
    .hero__cta {
      --btn-h: 60px;
      font-size: 18px;
    }
    .hero__ctas .btn--primary {
      padding: 0 22px 0 28px;
      gap: 12px;
    }
    .hero__free {
      font-size: 16px;
      line-height: 22px;
    }
    .hero__stage {
      position: absolute;
      top: 150px;
      right: 36px;
      width: 418px;
      height: 900px;
      margin: 0;
      overflow: visible;
      transform: scale(0.8);
      transform-origin: top right;
    }
    .device {
      left: 0;
      top: 0;
      margin: 0;
      scale: none;
    }
  }
  @media (min-width: 1280px) {
    .hero__copy {
      width: 660px;
    }
    .hero__stage {
      transform: none;
    }
  }

  /* Motion moment A: the coin drops into the slot while the headline rises
     (from 150 ms, so the copy is never blank for long) and the phone
     settles, all done by about 1 s. Pure CSS, so it plays without JS; once
     per session (html.hero-seen). The keyframes for the icon are in
     global.css, shared with /i. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.hero-seen)) .hero__icon :global(.ai-tile),
    :global(html:not(.hero-seen)) .hero__eyebrow {
      animation: hero-fade 160ms linear both;
    }
    :global(html:not(.hero-seen)) .hero__icon :global(.ai-slot) {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: hero-slot 760ms linear both;
    }
    :global(html:not(.hero-seen)) .hero__icon :global(.ai-plate) {
      animation: hero-plate 760ms linear both;
    }
    :global(html:not(.hero-seen)) .hero__icon :global(.ai-coin) {
      animation: hero-coin 600ms 160ms both;
    }
    :global(html:not(.hero-seen)) .hero__title,
    :global(html:not(.hero-seen)) .hero__lead,
    :global(html:not(.hero-seen)) .hero__ctas {
      animation: hero-rise 600ms var(--ease-out-soft) both;
    }
    :global(html:not(.hero-seen)) .hero__title {
      animation-delay: 150ms;
    }
    :global(html:not(.hero-seen)) .hero__lead {
      animation-delay: 230ms;
    }
    :global(html:not(.hero-seen)) .hero__ctas {
      animation-delay: 290ms;
    }
    /* No opacity on the stage: the phone is the largest paint. `translate`
       composes with the stage's scale(.8) and the parallax transform. */
    :global(html:not(.hero-seen)) .hero__stage {
      animation: hero-stage 900ms var(--ease-out-soft) both;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes hero-stage {
    from {
      translate: 0 24px;
    }
  }
</style>
