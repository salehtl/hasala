---
import Icon from '../Icon.astro';
import { FAQ, SITE } from '../../data/site';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <div class="faq__aside" data-reveal>
      <span class="overline">FAQ</span>
      <h2 id="faq-title" class="display-panel">Questions, answered.</h2>
      <p class="intro faq__intro">Something we missed? Write to us and a person who builds Hasala will reply.</p>
      <a class="faq__mail" href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}<Icon name="arrow-right" size={14} stroke={1.9} /></a>
    </div>

    <div class="faq__list">
      {
        FAQ.map((item, i) => (
          <details class="qa" name="faq" open={i === 0}>
            <summary>
              <h3>{item.q}</h3>
              <span class="qa__toggle" aria-hidden="true">
                <Icon name="plus" size={14} stroke={1.8} class="qa__plus" />
                <Icon name="minus" size={14} stroke={1.8} class="qa__minus" />
              </span>
            </summary>
            <div class="qa__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 0 0 72px;
    background: var(--white);
  }
  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--neutral-200);
  }
  .faq__aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq__intro,
  .faq__mail {
    display: none;
  }
  .faq__mail {
    align-items: center;
    gap: 8px;
    padding-top: 4px;
    color: var(--text-link);
    font-size: 17px;
    font-weight: 600;
    line-height: 24px;
  }
  .faq__mail:hover {
    color: var(--blue-700);
  }
  .faq__mail :global(.icon) {
    transition: translate var(--t-hover-out) var(--ease-out-soft);
  }
  @media (hover: hover) and (pointer: fine) {
    .faq__mail:hover :global(.icon) {
      translate: 3px 0;
      transition-duration: 200ms;
    }
  }
  .qa {
    border-bottom: 1px solid var(--neutral-200);
  }
  .qa:last-child {
    border-bottom: 0;
  }
  /* The summary keeps its padding when open (no jump); the answer tucks up
     under it instead. The toggle sits on the first line of the question. */
  .qa summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    list-style: none;
    cursor: pointer;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa h3 {
    margin: 4px 0 -4px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 24px;
  }
  .qa__toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--neutral-100);
    color: var(--ink-900);
    transition:
      background-color var(--t-hover-out),
      color var(--t-hover-out),
      scale 100ms var(--ease-out-soft);
  }
  .qa summary:active .qa__toggle {
    scale: 0.95;
  }
  @media (hover: hover) and (pointer: fine) {
    .qa summary:hover .qa__toggle {
      background: var(--neutral-200);
    }
  }
  .qa[open] .qa__toggle {
    background: var(--ink-900);
    color: var(--white);
  }
  /* Plus turns into minus: they share one cell and cross-rotate. */
  .qa__toggle :global(.icon) {
    grid-area: 1 / 1;
    transition:
      rotate 220ms var(--ease-out-soft),
      opacity 160ms ease;
  }
  .qa :global(.qa__minus),
  .qa[open] :global(.qa__plus) {
    rotate: -90deg;
    opacity: 0;
  }
  .qa[open] :global(.qa__plus) {
    rotate: 90deg;
  }
  .qa[open] :global(.qa__minus) {
    rotate: 0deg;
    opacity: 1;
  }
  .qa__answer {
    /* Pulled up under the summary; positioned so its first line takes the
       taps, not the summary's padding beneath it. */
    position: relative;
    margin-top: -12px;
    padding: 0 56px 22px 0;
  }
  .qa__answer p {
    max-width: 600px;
    color: var(--text-body);
    font-size: 16px;
    line-height: 24px;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The answer fades and settles as it opens. On the details-content box,
       which keeps its style while closed, so the answer open on arrival
       stays still. */
    .qa::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      translate: 0 -6px;
      transition:
        block-size 240ms var(--ease-out-soft),
        content-visibility 240ms allow-discrete,
        opacity 200ms var(--ease-out-soft),
        translate 240ms var(--ease-out-soft);
    }
    .qa[open]::details-content {
      block-size: auto;
      block-size: calc-size(auto, size);
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (min-width: 1024px) {
    .faq {
      padding-bottom: 140px;
    }
    .faq__inner {
      flex-direction: row;
      gap: 96px;
      padding-top: 80px;
    }
    .faq__aside {
      flex: 0 0 380px;
      gap: 20px;
      align-self: flex-start;
      position: sticky;
      top: 120px;
    }
    .faq__intro {
      display: block;
    }
    .faq__mail {
      display: inline-flex;
    }
    .faq__list {
      flex: 1;
      min-width: 0;
    }
    .qa summary {
      padding: 28px 0;
    }
    .qa h3 {
      font-size: 21px;
      line-height: 28px;
    }
    .qa__toggle {
      width: 36px;
      height: 36px;
    }
    .qa__answer {
      margin-top: -16px;
      padding: 0 60px 28px 0;
    }
    .qa__answer p {
      font-size: 17px;
      line-height: 27px;
    }
  }
</style>
