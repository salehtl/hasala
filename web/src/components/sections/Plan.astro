---
const BUCKETS = [
  {
    key: 'needs',
    pct: '50%',
    name: 'Needs',
    line: 'The things that keep the lights on',
    short: 'Rent, groceries, utilities',
    cats: ['Rent', 'Groceries', 'Utilities', 'Transport', 'Insurance'],
    amount: '12,500',
  },
  { key: 'wants', pct: '30%', name: 'Wants', line: 'The things that make it a life', short: 'Dining, shopping, travel', cats: ['Dining', 'Shopping', 'Travel'], amount: '7,500' },
  { key: 'savings', pct: '20%', name: 'Savings', line: 'Future you, paid first', short: 'Future you, paid first', cats: ['Emergency fund'], amount: '5,000' },
];
---

<section class="plan" aria-labelledby="plan-title">
  <div class="container plan__inner">
    <header class="section-head" data-reveal>
      <div class="section-head__title plan__title">
        <span class="overline">Your plan</span>
        <h2 id="plan-title" class="display-l">Start at 50/30/20. Then make it yours.</h2>
      </div>
      <p class="intro section-head__intro">
        Every category lives in one of three buckets. Move money between them whenever life changes; Hasala keeps the sums honest.
      </p>
    </header>

    <div class="split" aria-hidden="true" data-reveal><span class="split--needs"></span><span class="split--wants"></span><span class="split--savings"></span></div>

    <ul class="buckets" role="list">
      {
        BUCKETS.map((b) => (
          <li class:list={['bucket', `bucket--${b.key}`]} data-reveal>
            <div class="bucket__head">
              <p class="bucket__pct figure">{b.pct}</p>
              <div class="bucket__name">
                <h3>{b.name}</h3>
                <p class="bucket__line">{b.line}</p>
                <p class="bucket__short">{b.short}</p>
              </div>
            </div>
            <div class="bucket__foot">
              <ul class="bucket__cats" role="list">
                {b.cats.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              <p class="bucket__amount">
                <span class="bucket__unit">AED</span>
                <span class="figure">{b.amount}</span>
                {b.key === 'needs' && <span class="bucket__on">a month on a 25,000 salary</span>}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="plan__note">Shown on a 25,000 monthly salary.</p>
  </div>
</section>

<style>
  .plan {
    padding: 72px 0 80px;
    background: var(--neutral-100);
  }
  .plan__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .plan__title {
    max-width: 520px;
  }
  .split {
    display: flex;
    gap: 4px;
    height: 12px;
  }
  .split span {
    border-radius: 6px;
  }
  .split--needs {
    flex: 50;
    background: #e6c48f;
  }
  .split--wants {
    flex: 30;
    background: #c4b2e6;
  }
  .split--savings {
    flex: 20;
    background: #a6d5bf;
  }
  .buckets {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bucket {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name pct' 'amount pct';
    align-items: center;
    gap: 10px 12px;
    border-radius: 28px;
    padding: 22px;
  }
  .bucket__head,
  .bucket__foot {
    display: contents;
  }
  .bucket__pct {
    grid-area: pct;
  }
  .bucket__name {
    grid-area: name;
    align-self: end;
  }
  .bucket__amount {
    grid-area: amount;
    align-self: start;
  }
  .bucket--needs {
    flex: 50 1 0;
    background: linear-gradient(in oklab 165deg, var(--hue-sand-start), var(--hue-sand-end));
    color: var(--hue-sand-ink);
    --rule: rgb(90 58 18 / 16%);
  }
  .bucket--wants {
    flex: 30 1 0;
    background: linear-gradient(in oklab 165deg, var(--hue-lilac-start), var(--hue-lilac-end));
    color: var(--hue-lilac-ink);
    --rule: rgb(60 42 102 / 16%);
  }
  .bucket--savings {
    flex: 20 1 0;
    background: linear-gradient(in oklab 165deg, var(--hue-mint-start), var(--hue-mint-end));
    color: var(--hue-mint-ink);
    --rule: rgb(22 74 53 / 16%);
  }
  .bucket__pct {
    font-size: 72px;
    letter-spacing: -0.04em;
    line-height: 72px;
  }
  .bucket__name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bucket__name h3 {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 26px;
  }
  .bucket__line {
    display: none;
    font-size: 16px;
    line-height: 22px;
    opacity: 0.8;
  }
  .bucket__short {
    font-size: 14px;
    line-height: 20px;
  }
  .bucket__cats {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bucket__cats li {
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 70%);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
  }
  .bucket__amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 16px;
    line-height: 20px;
  }
  .bucket__unit {
    font-family: var(--font-figure);
    font-weight: 600;
  }
  .bucket__amount .figure {
    font-weight: 700;
  }
  .bucket__on {
    display: none;
    font-size: 15px;
    line-height: 20px;
    opacity: 0.8;
  }
  .plan__note {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 18px;
  }

  @media (min-width: 1024px) {
    .plan {
      padding: 140px 0;
    }
    .plan__inner {
      gap: 56px;
    }
    .split,
    .plan__note,
    .bucket__short {
      display: none;
    }
    .buckets {
      flex-direction: row;
      gap: 16px;
    }
    .bucket {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 420px;
      gap: 32px;
      padding: 32px 28px;
      border-radius: 32px;
    }
    .bucket--needs {
      padding: 32px;
    }
    .bucket--savings {
      padding: 32px 24px;
    }
    .bucket__head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 12px;
    }
    .bucket__name {
      padding-top: 8px;
    }
    .bucket--needs .bucket__head {
      gap: 20px;
    }
    .bucket--needs .bucket__name {
      padding-top: 0;
    }
    .bucket__name h3 {
      font-size: 28px;
      line-height: 34px;
    }
    .bucket__line {
      display: block;
    }
    .bucket--needs .bucket__pct {
      font-size: 136px;
      line-height: 120px;
    }
    .bucket--wants .bucket__pct {
      font-size: 96px;
      line-height: 88px;
    }
    .bucket__foot {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .bucket__cats {
      display: flex;
    }
    .bucket__amount {
      padding-top: 16px;
      border-top: 1px solid var(--rule);
      font-size: 15px;
    }
    .bucket__amount .figure {
      font-size: 24px;
      line-height: 28px;
    }
    .bucket__on {
      display: inline;
    }
  }

  /* As the 50/30/20 bar itself comes into view it fills left to right
     (small screens); on large ones each bucket's categories drop in after
     it. */
  @media (prefers-reduced-motion: no-preference) {
    .split span {
      transform-origin: left;
      transition: scale 480ms var(--ease-out-soft) 200ms;
    }
    .split span:nth-child(2) {
      transition-delay: 320ms;
    }
    .split span:nth-child(3) {
      transition-delay: 440ms;
    }
    /* The fill is the bar's whole entrance: no fade or rise around it. */
    :global(.js) .split:not(:global(.is-in)) {
      opacity: 1;
      transform: none;
    }
    :global(.js) .split:not(:global(.is-in)) span {
      scale: 0 1;
    }
    .bucket__cats li {
      --n: 0;
      transition:
        opacity 260ms var(--ease-out-soft),
        translate 260ms var(--ease-out-soft);
      transition-delay: calc(var(--i, 0) * 60ms + 280ms + var(--n) * 40ms);
    }
    .bucket__cats li:nth-child(2) {
      --n: 1;
    }
    .bucket__cats li:nth-child(3) {
      --n: 2;
    }
    .bucket__cats li:nth-child(4) {
      --n: 3;
    }
    .bucket__cats li:nth-child(5) {
      --n: 4;
    }
    :global(.js) .bucket:not(:global(.is-in)) .bucket__cats li {
      opacity: 0;
      translate: 0 6px;
    }
  }
</style>
