---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { JS_CLASS } from '../lib/inline-scripts.mjs';

interface Props {
  /** The page part of the title: "Hasala · {title}". */
  title: string;
  description: string;
  /** Canonical path; defaults to the current path. */
  path?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  nav?: 'full' | 'invite' | 'minimal';
  footer?: boolean;
  /** The footer's colour: navy when the page ends on a navy band. */
  footerTone?: 'white' | 'navy';
  /** Pages whose address can carry a code or token send no referrer at all. */
  referrer?: 'no-referrer';
  /**
   * The colour at the top of the page (the first block's wash), for the
   * strip behind the status bar before scripts/edges.ts runs or without
   * JavaScript. The same values are --edge-* in global.css.
   */
  edge?: keyof typeof EDGE;
  class?: string;
}

const EDGE = { white: '#ffffff', sky: '#d3e6ff', soft: '#e6eeff', legal: '#eef1ff', navy: '#142659' } as const;

const { title, description, path, noindex = false, ogType = 'website', jsonLd, nav = 'full', footer = true, footerTone = 'white', referrer, edge = 'white', class: className } = Astro.props;
const fullTitle = `Hasala · ${title}`;
// https://hasala.app/ for the home page, https://hasala.app/privacy (no slash) elsewhere.
const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" dir="ltr" data-edge={edge === 'white' ? undefined : edge}>
  <head>
    <meta charset="utf-8" />
    {referrer && <meta name="referrer" content={referrer} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={EDGE[edge]} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content="Hasala" />
    <meta name="apple-mobile-web-app-title" content="Hasala" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#142659" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Hasala for language models" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Hasala" />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <Font cssVariable="--font-inter" preload />

    <script is:inline set:html={JS_CLASS} />
    <ClientRouter />
    <slot name="head" />
    {ld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class={className}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="edge-top" aria-hidden="true"></div>
    <div class="edge-bottom" aria-hidden="true"></div>
    <Nav variant={nav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer tone={footerTone} />}
  </body>
</html>

<script>
  import '../scripts/router';
  import '../scripts/edges';
</script>
