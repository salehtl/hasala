---
/**
 * hasala.app/i/<code>: the invite page ("Invite · hasala.app/i/<code>").
 * One static page serves every code (public/_redirects rewrites /i/* here);
 * a few lines of script read the code from the address bar. On an iPhone
 * with Hasala installed the link opens the app instead (universal link).
 *
 * The invite email links to /i/<CODE>#<LINK_KEY>. The page may show the
 * code, never calls the API and sends no referrer. It runs only its own
 * code: Cloudflare's edge adds its Web Analytics beacon to every HTML page,
 * and Web Analytics records paths, so this page's CSP header
 * (public/_headers) does not admit it, and the router always loads the page
 * in full (src/scripts/router.ts) so that header applies. Once read, the
 * code and link key leave the address bar and the history entry. It shows
 * the external-TestFlight steps (testers are invited by email or link, need
 * no App Store Connect account and never see each other). The page never
 * calls the API, so it cannot know an invite's expiry and shows no date.
 * The older /i#<CODE> form works too.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/brand/AppIcon.astro';
import HomePhone from '../components/HomePhone.astro';
import { SITE } from '../data/site';

// Opens the TestFlight app on an iPhone (Apple's own address); the invite itself arrives by Apple's email.
const TESTFLIGHT_OPEN = 'https://testflight.apple.com/';
---

<Base
  title="You’ve been invited"
  description="Your invite to the Hasala beta: get TestFlight, accept Apple's TestFlight invitation, install Hasala, then open Hasala and type your invite code."
  path="/i"
  noindex
  nav="invite"
  referrer="no-referrer"
>
  <section class="invite" id="invite" aria-labelledby="invite-title">
    <div class="container invite__inner">
      <div class="invite__copy">
        <div class="invite__badge">
          <span class="invite__tile"><AppIcon id="invite-icon" size={56} /></span>
          <p class="invite__code-chip">
            <span class="invite__coin" aria-hidden="true"></span>
            <span class="invite__id"><span>Invite</span> <code data-code hidden></code></span>
          </p>
        </div>

        <h1 id="invite-title" class="display-invite invite__title">You've been invited.</h1>
        <p class="lead invite__lead">
          <span class="is-wide">A place in the Hasala beta is saved for you. Setting up takes about five minutes on your iPhone.</span>
          <span class="is-narrow">Your place in the Hasala beta is ready. It takes about five minutes on this iPhone.</span>
        </p>

        <div class="invite__ctas">
          <a class="btn btn--primary invite__cta" href={TESTFLIGHT_OPEN}>Open invite in TestFlight</a>
          <a class="btn btn--glass invite__cta invite__cta--second" href={SITE.testFlightAppStore}>No TestFlight yet? Get it first</a>
        </div>

        <ol class="isteps" role="list">
          <li>
            <span class="coin-badge">1</span>
            <div class="isteps__text">
              <h2>Get TestFlight</h2>
              <p>
                <span class="is-wide">Apple's free app for trying betas, from the App Store.</span>
                <span class="is-narrow">Apple's free app for betas.</span>
              </p>
            </div>
            <a class="btn btn--subtle btn--sm isteps__btn" href={SITE.testFlightAppStore}>Get TestFlight</a>
          </li>
          <li>
            <span class="coin-badge">2</span>
            <div class="isteps__text">
              <h2>Open your invite</h2>
              <p>
                <span class="is-wide">TestFlight opens with Hasala ready to install.</span>
                <span class="is-narrow">Hasala appears in TestFlight. Tap Install.</span>
              </p>
            </div>
            <a class="btn btn--primary btn--sm isteps__btn" href={TESTFLIGHT_OPEN}>Open in TestFlight</a>
          </li>
          <li>
            <span class="coin-badge">3</span>
            <div class="isteps__text">
              <h2><span class="is-wide">Install and set up</span><span class="is-narrow">Set up</span></h2>
              <p>Choose Face ID or a password, write down your 12 words, connect Gmail.</p>
            </div>
            <button class="btn btn--subtle btn--sm isteps__btn" type="button" data-copy-code hidden>
              <Icon name="copy" size={16} stroke={1.6} /><span>Copy code</span>
            </button>
          </li>
        </ol>

        <div class="invite__qr" data-qr-wrap hidden>
          <span class="invite__qr-box" data-qr aria-hidden="true"></span>
          <p>
            <b>Reading this on a computer?</b>
            Point your iPhone's camera here to open this invite on the phone. Invites are personal and work once.
          </p>
        </div>

        <p class="invite__fine">Invites are personal and work once. Not expecting this? You can ignore it.</p>
      </div>

      <div class="invite__stage" aria-hidden="true" data-alive>
        <div class="device--invite">
          <HomePhone play="load" />
        </div>
        <div class="invite__saved">
          <span class="invite__saved-coin">
            <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false"><rect x="10" y="14.5" width="20" height="4" rx="2" fill="#8A5A05"></rect><rect x="10" y="21.5" width="20" height="4" rx="2" fill="#8A5A05"></rect></svg>
          </span>
          <span><b>Your place is saved</b><small>This invite is just for you</small></span>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../scripts/page';

  // The code: 24 base32 characters, from /i/<code> or, in the
  // older form, from /i#<code>. Hyphens and spaces are ignored, as in the app.
  const norm = (v: string) => v.toUpperCase().replace(/[\s-]/g, '');
  const isCode = (v: string) => /^[A-Z2-7]{24}$/.test(v);

  // Through onPage, like every page script, though the router always loads this page in full.
  onPage((signal) => {
    if (!document.querySelector('[data-code]')) return;
    const fragment = location.hash.slice(1);
    const match = /^\/i\/([^/?#]+)/.exec(location.pathname);
    // The code and the link key leave the address bar and the history entry
    // (the router's state stays, so Back and Forward still work).
    if (location.pathname !== '/i' || location.search || location.hash) history.replaceState(history.state, '', '/i');
    let code = '';
    let linkKey = '';
    try {
      code = match ? norm(decodeURIComponent(match[1])) : '';
    } catch {
      code = '';
    }
    if (isCode(code)) {
      // The link key proves the address; only the email carries it.
      if (/^[A-Za-z0-9_-]{43}$/.test(fragment)) linkKey = fragment;
    } else {
      code = isCode(norm(fragment)) ? norm(fragment) : '';
    }
    if (!code) return;

    const shown = code.match(/.{4}/g)!.join('-');
    document.querySelectorAll<HTMLElement>('[data-code]').forEach((el) => {
      el.textContent = shown;
      el.hidden = false;
    });

    const copy = document.querySelector<HTMLButtonElement>('[data-copy-code]');
    if (copy && navigator.clipboard) {
      copy.hidden = false;
      copy.addEventListener(
        'click',
        async () => {
          const label = copy.querySelector('span')!;
          try {
            await navigator.clipboard.writeText(shown);
            label.textContent = 'Copied';
          } catch {
            label.textContent = shown;
          }
          setTimeout(() => (label.textContent = 'Copy code'), 2000);
        },
        { signal },
      );
    }

    // A QR code of this link, link key included, for people reading on a computer.
    if (matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
      import('uqr').then(({ encode }) => {
        const box = document.querySelector('[data-qr]');
        if (signal.aborted || !box) return;
        const { data, size } = encode(`https://hasala.app/i/${code}${linkKey ? `#${linkKey}` : ''}`, { ecc: 'M', border: 0 });
        const ns = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(ns, 'svg');
        svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
        svg.setAttribute('shape-rendering', 'crispEdges');
        let d = '';
        data.forEach((row, y) => row.forEach((on, x) => on && (d += `M${x} ${y}h1v1h-1z`)));
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('d', d);
        path.setAttribute('fill', '#202023');
        svg.append(path);
        box.replaceChildren(svg);
        document.querySelector<HTMLElement>('[data-qr-wrap]')!.hidden = false;
      });
    }
  });
</script>

<style>
  .invite {
    position: relative;
    overflow: clip;
    background: var(--wash-hero-m);
  }
  .invite__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 108px 0 40px;
  }
  .invite__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .is-wide {
    display: none;
  }
  .invite__badge {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .invite__tile {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 13px;
    box-shadow: rgb(20 38 89 / 26%) 0 10px 22px;
  }
  .invite__tile :global(svg) {
    width: 100%;
    height: 100%;
  }
  .invite__code-chip {
    display: flex;
    flex-direction: column;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }
  .invite__coin {
    display: none;
  }
  .invite__id {
    overflow-wrap: anywhere;
  }
  .invite__code-chip code {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
  }
  .invite__until {
    color: var(--text-secondary);
    font-weight: 400;
  }
  .invite__title {
    padding-top: 8px;
  }
  .invite__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
  }
  .invite__cta {
    width: 100%;
    height: 58px;
    font-size: 17px;
    font-weight: 600;
    box-shadow: rgb(54 91 235 / 30%) 0 8px 20px;
  }
  .invite__cta--second {
    height: 52px;
    font-size: 16px;
    box-shadow: rgb(0 0 0 / 8%) 0 0 0 0.5px;
  }
  .isteps {
    display: flex;
    flex-direction: column;
    margin-top: 12px;
    padding: 4px 18px;
    border-radius: 24px;
    background: var(--white);
    box-shadow: rgb(20 38 89 / 8%) 0 12px 28px;
  }
  .isteps li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 6px 14px;
    padding: 16px 0;
  }
  .isteps li + li {
    border-top: 1px solid var(--neutral-200);
  }
  .isteps .coin-badge {
    width: 28px;
    height: 28px;
    font-size: 14px;
    line-height: 18px;
  }
  .isteps__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .isteps__text h2 {
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
  }
  .isteps__text p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 20px;
  }
  .isteps__btn {
    display: none;
  }
  .isteps__btn[data-copy-code]:not([hidden]) {
    display: inline-flex;
    grid-column: 2;
    justify-self: start;
  }
  .invite__qr {
    display: none;
  }
  .invite__qr-box {
    flex: none;
    width: 84px;
    height: 84px;
    padding: 10px;
    border-radius: 14px;
    background: var(--white);
    box-shadow: rgb(0 0 0 / 8%) 0 0 0 1px;
  }
  .invite__qr p {
    max-width: 360px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 21px;
  }
  .invite__qr b {
    display: block;
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }
  .invite__fine {
    padding-top: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 19px;
    text-align: center;
  }
  .invite__stage {
    display: none;
  }

  @media (min-width: 1024px) {
    .invite {
      background: var(--wash-hero);
    }
    .invite__inner {
      flex-direction: row;
      min-height: 1000px;
      padding: 168px 0 80px;
    }
    .is-wide {
      display: inline;
    }
    .is-narrow {
      display: none;
    }
    .invite__copy {
      width: 640px;
      gap: 20px;
    }
    .invite__tile,
    .invite__ctas,
    .invite__fine {
      display: none;
    }
    .invite__code-chip {
      flex-direction: row;
      align-items: center;
      gap: 10px;
      height: 36px;
      padding: 0 14px 0 8px;
      border-radius: var(--r-pill);
      background: rgb(255 255 255 / 75%);
      box-shadow: rgb(0 0 0 / 6%) 0 0 0 0.5px;
      font-size: 14px;
      line-height: 18px;
    }
    .invite__badge {
      align-self: flex-start;
    }
    .invite__coin {
      display: block;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--coin);
      box-shadow: var(--gold-edge) 0 1px 0;
    }
    .invite__until {
      display: none;
    }
    .invite__code-chip code {
      color: var(--text-body);
      font-family: var(--font-mono);
      font-weight: 500;
      white-space: nowrap;
      font-size: 13px;
      line-height: 18px;
    }
    .invite__title {
      padding-top: 0;
    }
    .invite__lead {
      max-width: 560px;
    }
    .isteps {
      width: 600px;
      padding: 8px 24px;
      border-radius: 28px;
      box-shadow: rgb(20 38 89 / 10%) 0 20px 40px, rgb(0 0 0 / 4%) 0 0 0 0.5px;
    }
    .isteps li {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 16px;
      padding: 20px 0;
    }
    .isteps .coin-badge {
      width: 32px;
      height: 32px;
      font-size: 15px;
      line-height: 20px;
    }
    .isteps__text h2 {
      font-size: 17px;
    }
    .isteps__text p {
      font-size: 15px;
      line-height: 22px;
    }
    .isteps__btn {
      display: inline-flex;
      --btn-h: 40px;
      --btn-px: 18px;
      font-size: 15px;
    }
    .isteps__btn[data-copy-code]:not([hidden]) {
      grid-column: auto;
    }
    .invite__qr {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 8px;
    }
    .invite__qr[hidden] {
      display: none;
    }
    .invite__stage {
      position: absolute;
      top: 150px;
      right: 36px;
      display: block;
      width: 418px;
      height: 900px;
      transform: scale(0.8);
      transform-origin: top right;
    }
    .device--invite {
      position: absolute;
      inset: 0 auto auto 0;
      width: 418px;
      /* The phone fades into the page wash at the bottom, as in Paper. */
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 92%);
      mask-image: linear-gradient(to bottom, #000 62%, transparent 92%);
    }
    .invite__saved {
      position: absolute;
      left: 272px;
      top: 495px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 22px 12px 12px;
      border-radius: var(--r-pill);
      background: rgb(255 255 255 / 90%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      box-shadow: rgb(20 38 89 / 16%) 0 18px 40px, rgb(0 0 0 / 6%) 0 0 0 0.5px;
      rotate: 3deg;
      white-space: nowrap;
    }
    .invite__saved-coin {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--coin);
      box-shadow: var(--gold-edge) 0 2px 0;
    }
    .invite__saved-coin svg {
      display: block;
    }
    .invite__saved b {
      display: block;
      font-size: 15px;
      font-weight: 600;
      line-height: 20px;
    }
    .invite__saved small {
      color: var(--text-secondary);
      font-size: 13px;
      line-height: 18px;
    }
  }
  @media (min-width: 1280px) {
    .invite__stage {
      transform: none;
    }
  }

  /* The hero's coin drops into the tile (keyframes in global.css); on large
     screens the "place is saved" pill settles instead. Once per page load:
     not after a client-side navigation (html.routed, scripts/router.ts). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.routed)) .invite__tile :global(.ai-tile) {
      animation: hero-fade 160ms linear both;
    }
    :global(html:not(.routed)) .invite__tile :global(.ai-slot) {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: hero-slot 760ms linear both;
    }
    :global(html:not(.routed)) .invite__tile :global(.ai-plate) {
      animation: hero-plate 760ms linear both;
    }
    :global(html:not(.routed)) .invite__tile :global(.ai-coin) {
      animation: hero-coin 600ms 160ms both;
    }
    :global(html:not(.routed)) .invite__saved {
      animation: invite-saved 520ms 900ms var(--ease-out-soft) both;
    }
  }
  @keyframes invite-saved {
    from {
      opacity: 0;
      translate: 0 -16px;
      rotate: 6deg;
    }
  }
</style>
