  .plain-words__coin::after {
    content: '';
    position: absolute;
    left: 9px;
    right: 9px;
    height: 1.8px;
    border-radius: 1px;
    background: var(--gold-rule);
  }
  .plain-words__coin::before {
    top: 11px;
  }
  .plain-words__coin::after {
    top: 15px;
  }
  .plain-words p {
    margin: 0;
  }
  .plain-words__title {
    font-weight: 700;
  }
  .anchor-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--accent-subtle);
    color: var(--accent);
    opacity: 0;
    transition: opacity var(--t-hover-out);
  }
  .prose h2:hover .anchor-copy,
  .anchor-copy:focus-visible,
  .anchor-copy:has(.anchor-copy__note:not(:empty)) {
    opacity: 1;
  }
  @media (hover: none) {
    .anchor-copy {
      opacity: 1;
    }
  }
  .anchor-copy__note {
    position: absolute;
    left: calc(100% + 10px);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .empty {
    display: flex;
    flex-direction: column;
    gap: 12px;
