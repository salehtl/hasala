---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Spending from '../components/sections/Spending.astro';
import SwipeReview from '../components/sections/SwipeReview.astro';
import PlanSplit from '../components/sections/PlanSplit.astro';
import BillsFound from '../components/sections/BillsFound.astro';
import Privacy from '../components/sections/Privacy.astro';
import Banks from '../components/sections/Banks.astro';
import Faq from '../components/sections/Faq.astro';
import Beta from '../components/sections/Beta.astro';
import { SITE } from '../data/site';
import { HERO_SEEN } from '../lib/inline-scripts.mjs';

const org = { '@id': `${SITE.url}/#organization` };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      ...org,
      name: 'Hasala',
      alternateName: SITE.arabicName,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
      email: SITE.supportEmail,
      areaServed: { '@type': 'Country', name: 'United Arab Emirates' },
      contactPoint: [
        { '@type': 'ContactPoint', contactType: 'customer support', email: SITE.supportEmail, availableLanguage: 'English' },
        { '@type': 'ContactPoint', contactType: 'privacy', email: SITE.privacyEmail, availableLanguage: 'English' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: 'Hasala',
      alternateName: [SITE.arabicName, SITE.appStoreName],
      description: SITE.description,
      inLanguage: 'en',
      publisher: org,
    },
    {
      '@type': 'MobileApplication',
      '@id': `${SITE.url}/#app`,
      name: SITE.appStoreName,
      alternateName: ['Hasala', SITE.arabicName],
      url: SITE.url,
      description: SITE.description,
      image: `${SITE.url}${SITE.ogImage}`,
      applicationCategory: 'FinanceApplication',
      applicationSubCategory: 'Personal budgeting',
      operatingSystem: 'iOS 26 or later',
      softwareVersion: 'Beta (TestFlight)',
      inLanguage: 'en',
      countriesSupported: 'AE',
      isAccessibleForFree: true,
      featureList: [
        'Reads your bank’s alert emails from Gmail, read-only, on your iPhone',
        'Works with Dubai Islamic Bank and Emirates NBD',
        'Turns alerts into transactions and sorts most into categories; you confirm the rest',
        'Shows where your money went, what’s left, and a simple plan for the month',
        'Transactions and budget are encrypted on your iPhone before they sync; our server can’t read them',
        'No bank login; can’t move money',
      ],
      offers: {
        '@type': 'Offer',
        price: 0,
        priceCurrency: 'AED',
        availability: 'https://schema.org/LimitedAvailability',
        description: 'Free during the invite-only TestFlight beta.',
        url: `${SITE.url}/#invite`,
      },
      publisher: org,
    },
  ],
};
---

<Base title="Private budgeting app for iPhone" description={SITE.description} path="/" jsonLd={jsonLd} edge="sky">
  <script is:inline slot="head" set:html={HERO_SEEN} />
  <Hero />
  <HowItWorks />
  <Spending />
  <SwipeReview />
  <PlanSplit />
  <BillsFound />
  <Privacy />
  <Banks />
  <Faq />
  <Beta />
</Base>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
