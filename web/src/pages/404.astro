---
import Base from '../layouts/Base.astro';
import MissedCoin from '../components/brand/MissedCoin.astro';
---

<Base title="Page not found" description="This page has moved or never existed." path="/404" noindex footer={false} class="nf-page">
  <section class="nf" aria-labelledby="nf-title">
    <MissedCoin />
    <p class="nf__code">404</p>
    <h1 id="nf-title" class="display-404 nf__title">This one missed the slot.</h1>
    <p class="nf__lead">The page you're looking for has moved or never existed. Nothing to do with your money — that's safe on your iPhone.</p>
    <div class="nf__ctas">
      <a class="btn btn--primary btn--lg" href="/">Back to the home page</a>
      <a class="btn btn--glass btn--lg" href="/support">Get support</a>
    </div>
    <nav class="nf__more" aria-label="Popular pages">
      <span>Looking for:</span>
      <a href="/how-privacy-works">How privacy works</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/#invite">Request an invite</a>
    </nav>
  </section>
</Base>

<style>
  :global(.nf-page) {
    background: var(--wash-soft);
    min-height: 100vh;
  }
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 840px;
    margin: 0 auto;
    justify-content: center;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 116px var(--gutter) 48px;
    text-align: center;
  }
  .nf__ctas .btn {
    --btn-h: 56px;
    font-size: 17px;
    line-height: 22px;
    letter-spacing: 0;
  }
  .nf__ctas .btn--primary {
    --btn-px: 26px;
    box-shadow: rgb(54 91 235 / 30%) 0 8px 20px;
  }
  .nf__ctas .btn--glass {
    --btn-px: 24px;
    background: #ffffffcc;
  }
  @media (max-width: 520px) {
    .nf__ctas {
      flex-direction: column;
      align-self: stretch;
      align-items: stretch;
    }
  }
  .nf :global(.missed-coin) {
    width: min(360px, 90%);
    height: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nf :global(.missed-coin-body) {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: nf-wobble 900ms 200ms var(--ease-out-soft) both;
    }
  }
  @keyframes nf-wobble {
    0% {
      transform: translate(-60px, -40px) rotate(-30deg);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    70% {
      transform: rotate(6deg);
    }
    100% {
      transform: none;
    }
  }
  .nf__code {
    padding-top: 40px;
    color: var(--accent);
    font-family: var(--font-figure);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .nf__title {
    padding-top: 16px;
    text-align: center;
  }
  .nf__lead {
    max-width: 560px;
    padding-top: 16px;
    color: var(--neutral-700);
    font-size: clamp(17px, 16.26px + 0.19vw, 19px);
    line-height: 1.526;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding-top: 36px;
  }
  .nf__more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    padding-top: 40px;
    align-items: center;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 20px;
  }
  .nf__more a {
    color: var(--text-link);
    font-weight: 500;
  }
  .nf__more a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .nf {
      padding-top: 92px;
      padding-bottom: 0;
    }
  }
</style>
