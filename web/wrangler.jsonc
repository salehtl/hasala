// hasala.app: the marketing site, served as Workers Static Assets by the
// existing "hasala-aasa" Worker (which already served the AASA file). There
// is no Worker script: dist/ is the whole site, including
// /.well-known/apple-app-site-association, _headers and _redirects.
//
// Cloudflare Workers Builds (the Worker's Git integration) deploys it: a push
// to main deploys hasala.app, and a push to the `preview` branch deploys the
// preview site (env "preview" below, its own Worker). No other branch builds,
// so a pull request carries no Cloudflare check unless its head is pushed to
// `preview`. By hand, `bun run deploy` from this directory builds (with the
// dist checks) and runs the pinned wrangler (package.json), with
// CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID from the environment; see
// CLAUDE.md, "Website".
{
  "name": "hasala-aasa",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // dist/404.html for anything that is not a file.
    "not_found_handling": "404-page",
    // privacy.html is served at /privacy; /privacy/ redirects to /privacy.
    "html_handling": "drop-trailing-slash"
  },
  // A zone route, not a custom domain: the deploy token cannot manage custom
  // domains.
  "routes": [{ "pattern": "hasala.app/*", "zone_name": "hasala.app" }],
  // No hasala-aasa.<account>.workers.dev copy of the live site.
  "workers_dev": false,
  // Off: previews come from the `preview` branch, not a URL per branch.
  "preview_urls": false,
  // Off: request logs would record /i/<code> paths (invite codes must not be logged).
  "observability": { "enabled": false },
  // No usage telemetry from wrangler itself.
  "send_metrics": false,
  "env": {
    // The preview site: Worker "hasala-aasa-preview", deployed by Workers
    // Builds from the `preview` branch with `npx wrangler deploy --env preview`.
    // It serves the same dist/ on its workers.dev address only, kept behind
    // Cloudflare Access. routes and workers_dev are set here because an
    // environment inherits them: without these two lines it would take the
    // hasala.app route.
    "preview": {
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": false }
    }
  }
}
